                          <KeepTogether>true</KeepTogether>
                          <Paragraphs>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>=
IIf(Fields!IsRegulated.Value, "Regularizada", "") &amp;
IIf((Fields!IsRegulated.Value And Not IsNothing(Fields!TranferredID.Value)) Or Not IsNothing(Fields!NextTransferID.Value), " - ", "") &amp;
IIf(Not IsNothing(Fields!TranferredID.Value),
     "Traspasada de N° " &amp; CStr(Fields!TranferredID.Value),
     IIf(Not IsNothing(Fields!NextTransferID.Value),
         "Traspasada a N° " &amp; CStr(Fields!NextTransferID.Value),
         ""
     )
 )</Value>
                                  <Style>
                                    <FontWeight>Bold</FontWeight>
                                  </Style>
                                </TextRun>
