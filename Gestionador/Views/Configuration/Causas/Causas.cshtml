@model IEnumerable<Gestionador.Responses.CausaReponse>

@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Causas</h2>
    <button id="btnCrearCausa" class="btn btn-primary">
        <i class="bi bi-plus"></i>
        Crear Causa
    </button>
</div>
<div id="grid"></div>
<script>$(document).ready(function () {
        $("#grid").kendoGrid({
            dataSource: {
                transport: {
                    read: {
                        url: GetCausasAdmin,
                        dataType: "json"
                    },
                },
                schema: {
                    model: {
                        id: "ID",
                        fields: {
                            ID: { editable: false, nullable: true },
                            Causa: { type: "string", validation: { required: true } },
                            IsActive: { type: "boolean" },
                        }
                    }
                },
                pageSize: 10,
            },
            groupable: false,
            pageable: true,
            sortable: true,
            scrollable: true,
            editable: "inline",
            columns: [
                { field: "Causa", title: "Causa", width: "200px" },
                { field: "IsActive", title: "Activo", width: "100px", template: "#= IsActive ? 'Si' : 'No' #" },
                {
                    title: "Acciones",
                    width: "15%",
                    template: function (dataItem) {
                        return `<button class="btn btn-primary btn-sm bi-eye" onclick="loadView($('#modales'), '${urlAjaxParamId(ModalUpsertCausa, dataItem.ID)}')"></button>`;
                    },
                    attributes: {
                        style: "text-align: center",
                    },
                }
            ]
        });

        $("#btnCrearCausa").click(function () {
            showLoading(true);
            loadView($('#modales'), urlAjaxParamId(ModalUpsertCausa));
            showLoading(false);
        });
    });</script>