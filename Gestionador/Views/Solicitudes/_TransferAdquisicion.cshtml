@model Gestionador.Models.TransferAdquisicionViewModel
@{     
    List<dynamic> regiones = (List<dynamic>)ViewBag.Regiones;
}
<div class="modal fade" id="transferAdquisiconModal" tabindex="-1" aria-labelledby="transferAdquisiconModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="transferAdquisiconModalModalLabel">Transferir Adquisición</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                @using (Html.BeginForm("TransferAdquisicionAsync", "Solicitudes", FormMethod.Post, new { id = "transferForm", autocomplete = "off" }))
                {
                    @Html.AntiForgeryToken();
                    @Html.HiddenFor(Model => Model.ID)

                <div class="container-md mt-4">
                    <div class="card mt-4">
                        <div class="card-header d-flex justify-content-between align-items-center">
                            <h6 class="mb-0">Datos Comprador</h6>
                            <button class="btn btn-link" type="button" data-bs-toggle="collapse" data-bs-target="#collapseCard" aria-expanded="true" aria-controls="collapseCard">
                                <i class="bi bi-chevron-down" id="collapseIcon"></i>
                            </button>
                        </div>
                        <div id="collapseCard" class="collapse show">
                            <div class="card-body">
                                <div class="row mb-3">
                                    <div class="col-md-4 mb-3">
                                        <div class="input-group">
                                            <span class="input-group-text">Rut</span>
                                            @Html.TextBoxFor(Model => Model.Comprador.Rut, new { @class = "form-control rut-input", id = "CompTransferRut" })
                                        </div>
                                    </div>
                                    <div class="col-md-4 mb-3">
                                        <div class="input-group">
                                            <span class="input-group-text">Nombre</span>
                                            @Html.TextBoxFor(Model => Model.Comprador.Nombre, new { @class = "form-control", id = "CompTransferNombre" })
                                        </div>
                                    </div>
                                    <div class="col-md-4 mb-3">
                                        <div class="input-group">
                                            <span class="input-group-text">Apellido</span>
                                            @Html.TextBoxFor(Model => Model.Comprador.Apellido, new { @class = "form-control", id = "CompTransferApellido" })
                                        </div>
                                    </div>
                                </div>

                                <div class="row mb-3">
                                    <div class="col-md-6 mb-3">
                                        <div class="input-group">
                                            <span class="input-group-text">Región</span>
                                            @Html.DropDownList("CompRegionId", new SelectList(regiones, "ID", "FullData"), new { @class = "form-select", id = "CompTransferRegionId" })
                                        </div>
                                    </div>
                                    <div class="col-md-6 mb-3">
                                        <div class="input-group">
                                            <span class="input-group-text">Comuna</span>
                                            @Html.DropDownListFor(Model => Model.Comprador.ComunaID, new SelectList(Enumerable.Empty<SelectListItem>(), "ID", "Comuna"), new { @class = "form-select", id = "CompTransferComunaID" })
                                        </div>
                                    </div>
                                    <div class="col-md-9 mb-3">
                                        <div class="input-group">
                                            <span class="input-group-text">Dirección 1</span>
                                            @Html.TextBoxFor(Model => Model.Comprador.Direccion1, new { @class = "form-control", id = "CompTransferDireccion1" })
                                        </div>
                                    </div>

                                    <div class="col-md-3 mb-3">
                                        <div class="input-group">
                                            <span class="input-group-text">Número</span>
                                            @Html.TextBoxFor(Model => Model.Comprador.DirNum, new { @class = "form-control", id = "CompTransferDirNum" })
                                        </div>
                                    </div>
                                </div>

                                <div class="row mb-3">
                                    <div class="col-md-6 mb-3">
                                        <div class="input-group">
                                            <span class="input-group-text">Teléfono</span>
                                            @Html.TextBoxFor(Model => Model.Comprador.Telefono, new { @class = "form-control", id = "CompTransferTelefono" })
                                        </div>
                                    </div>
                                    <div class="col-md-6 mb-3">
                                        <div class="input-group">
                                            <span class="input-group-text">Email</span>
                                            @Html.TextBoxFor(Model => Model.Comprador.Email, new { @class = "form-control", @type = "email", id = "CompTransferEmail" })
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="card mt-4">
                        <div class="card-header d-flex justify-content-between align-items-center">
                            <h6 class="mb-0">Referente</h6>
                            <button class="btn btn-link" type="button" data-bs-toggle="collapse" data-bs-target="#collapseCardRef1" aria-expanded="true" aria-controls="collapseCardRef1">
                                <i class="bi bi-chevron-down" id="collapseIcon"></i>
                            </button>
                        </div>
                        <div id="collapseCardRef1" class="collapse show">
                            <div class="card-body">
                                <div class="row mb-3">
                                    <div class="col-md-4 mb-3">
                                        <div class="input-group">
                                            <span class="input-group-text">Rut</span>
                                            @Html.TextBoxFor(Model => Model.Referente.Rut, new { @class = "form-control rut-input", id = "RefTransferRut" })
                                        </div>
                                    </div>
                                    <div class="col-md-4 mb-3">
                                        <div class="input-group">
                                            <span class="input-group-text">Nombre</span>
                                            @Html.TextBoxFor(Model => Model.Referente.Nombre, new { @class = "form-control", id = "RefTransferNombre" })
                                        </div>
                                    </div>
                                    <div class="col-md-4 mb-3">
                                        <div class="input-group">
                                            <span class="input-group-text">Apellido</span>
                                            @Html.TextBoxFor(Model => Model.Referente.Apellido, new { @class = "form-control", id = "RefTransferApellido" })
                                        </div>
                                    </div>
                                </div>
                                <div class="row mb-3">
                                    <div class="col-md-6 mb-3">
                                        <div class="input-group">
                                            <span class="input-group-text">Región</span>
                                            @Html.DropDownList("RefRegionID", new SelectList(regiones, "ID", "FullData"), new { @class = "form-select", id = "RefTransferRegionId" })

                                        </div>
                                    </div>
                                    <div class="col-md-6 mb-3">
                                        <div class="input-group">
                                            <span class="input-group-text">Comuna</span>
                                            @Html.DropDownListFor(Model => Model.Referente.ComunaID, new SelectList(Enumerable.Empty<SelectListItem>(), "ID", "Comuna"), new { @class = "form-select", id = "RefTransferComunaID" })
                                        </div>
                                    </div>
                                    <div class="col-md-9 mb-3">
                                        <div class="input-group">
                                            <span class="input-group-text">Dirección 1</span>
                                            @Html.TextBoxFor(Model => Model.Referente.Direccion1, new { @class = "form-control", id = "RefTransferDireccion1" })
                                        </div>
                                    </div>

                                    <div class="col-md-3 mb-3">
                                        <div class="input-group">
                                            <span class="input-group-text">Número</span>
                                            @Html.TextBoxFor(Model => Model.Referente.DirNum, new { @class = "form-control", id = "RefTransferDirNum" })
                                        </div>
                                    </div>
                                </div>

                                <div class="row mb-3">
                                    <div class="col-md-6 mb-3">
                                        <div class="input-group">
                                            <span class="input-group-text">Teléfono</span>
                                            @Html.TextBoxFor(Model => Model.Referente.Telefono, new { @class = "form-control", id = "RefTransferTelefono" })
                                        </div>
                                    </div>
                                    <div class="col-md-6 mb-3">
                                        <div class="input-group">
                                            <span class="input-group-text">Email</span>
                                            @Html.TextBoxFor(Model => Model.Referente.Email, new { @class = "form-control", @type = "email", id = "RefTransferEmail" })
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                }
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-primary" id="transferButton">Transferir</button>
            </div>
        </div>
    </div>
</div>
<script>    
    $(document).ready(function () {
        $('.rut-input').on('input', function () {
            var formattedRut = formatRut($(this).val());
            $(this).val(formattedRut);
        });  

        $("#transferAdquisiconModal").modal('show');

        $('#CompTransferRegionId').on("change", function () {
            changeSelectCascade(GetComunasByRegionIdAsync, $(this).val(), $('#CompTransferComunaID'))
        });

        $('#RefTransferRegionId').on("change", function () {
            changeSelectCascade(GetComunasByRegionIdAsync, $(this).val(), $('#RefTransferComunaID'))
        });
        
        $("#transferButton").click(function () {
            showLoading(true);
            var formData = $('#transferForm').serialize();
            $.ajax({
                url: TransferAdquisicionAsync,
                type: 'POST',
                data: formData,
                success: function (response) {
                    if (response.success) {
                        showToast("success", response.message);
                        window.location.href = response.redirectUrl;
                    } else {
                        showToast("info", response.message);
                    }
                    showLoading(false);
                },
                error: function (e) {
                    showLoading(false);
                    showToast("error", "Ocurrió un error al procesar la solicitud.");
                }
            });
        });
    });
</script>