@model  Gestionador.Models.PasswordRequest
<div class="modal fade" id="changePasswordModal" tabindex="-1" aria-labelledby="creatModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="changePasswordModalLabel">Cambiar Contraseña</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                @using (Html.BeginForm("changePasswordAsync", "Users", FormMethod.Post, new { id = "changePasswordForm" }))
                {
                    @Html.AntiForgeryToken();

                    <div class="col-md-12 mb-3">
                        <div class="input-group">
                            <span class="input-group-text">Contraseña</span>
                            @Html.TextBoxFor(Model => Model.Password, new { @class = "form-control", id = "Password", type = "password" })
                        </div>
                    </div>

                    <div class="col-md-12 mb-3">
                        <div class="input-group">
                            <span class="input-group-text">Confirmar Contraseña</span>
                            @Html.TextBoxFor(Model => Model.PasswordConfirm, new { @class = "form-control", id = "PasswordConfirm", type = "password" })
                        </div>
                    </div>
                }
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-primary" id="submitButton">Guardar</button>
            </div>
        </div>
    </div>
</div>

<script>
    $(document).ready(function () {
        $("#changePasswordModal").modal('show');

        $('#submitButton').click(function () {
            showLoading(true);
            var formData = $('#changePasswordForm').serialize();
            $.ajax({
                url: ChangePasswordAsync,
                type: 'Post',
                data: formData,
                success: function (response) {
                    if (response.success) {
                        showToast("success", response.message);
                        $("#changePasswordModal").modal('hide');
                    } else {
                        showToast("info", response.message);
                    }
                    showLoading(false);
                },
                error: function () {
                    showLoading(false);
                    showToast("error", "Ocurrió un error al procesar la solicitud.");
                }
            });
        });
    });
</script>