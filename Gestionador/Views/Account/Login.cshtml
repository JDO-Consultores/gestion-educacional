@model Gestionador.Models.LoginViewModel
@{
    Layout = "~/Views/Shared/_LayoutLogin.cshtml";
}

<section class="ftco-section">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-6 col-lg-5">
                <div class="login-wrap p-4 p-md-5">
                    <div class="icon d-flex align-items-center justify-content-center">
                        <img src="~/Content/Assets/Logos/png/logo_300x300.png" alt="Login Image" class="img-fluid">
                    </div>
                    <h3 class="text-center mb-4">Ingrese sus credenciales!</h3>
                    @using (Html.BeginForm("Login", "Account", FormMethod.Post, new { @id = "loginForm" }))
                    {
                        <div class="form-group">
                            @Html.TextBoxFor(m => m.Username, new { @class = "form-control", type = "email", placeholder = "Email" })
                        </div>
                        <div class="form-group d-flex position-relative">
                            @Html.PasswordFor(m => m.Password, new { @class = "form-control", placeholder = "Password", @id = "passwordField" })
                            <button type="button" class="btn btn-light position-absolute end-0"
                                    style="border: none; top: 50%; transform: translateY(-50%);"
                                    id="togglePassword">
                                <i class="fa fa-eye" id="passwordIcon"></i>
                            </button>
                        </div>
                        <div>
                            <a href="@Url.Action("ForgotPassword", "Account")">¿Olvidó su contraseña?</a>
                        </div>
                        <div class="form-group">
                            <button type="submit" class="btn btn-primary rounded submit p-3 px-5">Ingresar</button>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</section>
<script>
    $(document).ready(function () {
        $('#togglePassword').on('click', function () {
            var passwordField = $('#passwordField');
            var passwordIcon = $('#passwordIcon');

            if (passwordField.attr('type') === 'password') {
                passwordField.attr('type', 'text');
                passwordIcon.removeClass('fa-eye').addClass('fa-eye-slash');
            } else {
                passwordField.attr('type', 'password');
                passwordIcon.removeClass('fa-eye-slash').addClass('fa-eye');
            }
        });
    });
        $('#loginForm').submit(function (event) {
            localStorage.clear('jwtToken');
            showLoading(true);
            event.preventDefault();

            var formData = $(this).serialize();

            $.ajax({
                url: '/Account/Login',
                type: 'POST',
                data: formData,
                success: function (data) {
                    if (data.success) {
                        window.location.href = '@Url.Action("BusquedasAdquisicion", "Solicitudes")';
                    } else {
                        showToast('info', "Los datos ingresados son incorrectos.")
                    }
                    showLoading(false);
                },
                error: function () {
                    showToast(true, "Ocurrio un error al procesar la solicitud.");
                    showLoading(false);
                }
            });
        });
</script>