@model Gestionador.Models.SeccionConceptoRequest
@{
    var cementerios = (List<dynamic>)ViewBag.Cementerios;
    var conceptos = (List<dynamic>)ViewBag.Conceptos;
    var servicios = (List<dynamic>)ViewBag.Servicios;
    var tipoMonedas = (List<dynamic>)ViewBag.TipoMonedas;
}

<div class="modal fade" id="createSeccionConcepto" tabindex="-1" aria-labelledby="creatModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="crearModalLabel">
                    Asignar Productos y Servicios
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                @using (Html.BeginForm("createSeccionConceptoAsync", "Patios", FormMethod.Post, new { id = "createSeccionConceptoForm", autocomplete = "off" }))
                {
                    @Html.AntiForgeryToken();

                    <div class="col-md-12 mb-3">
                        <div class="input-group">
                            <span class="input-group-text">Cementerio</span>
                            @Html.DropDownList("CementerioID", new SelectList(cementerios, "ID", "Cementerio"), "Seleccionar cementerio", new { @class = "form-select", id = "CementerioID" })
                        </div>
                    </div>
                    <div class="col-md-12 mb-3">
                        <div class="input-group">
                            <span class="input-group-text">Patio</span>
                            @Html.DropDownList("Patio", new SelectList(Enumerable.Empty<SelectListItem>(), "ID", "Patio"), new { @class = "form-select", id = "UbiPatioID" })
                        </div>
                    </div>

                    <div class="col-md-12 mb-3">
                        <div class="input-group">
                            <span class="input-group-text">Sección</span>
                            @Html.DropDownListFor(Model => Model.SeccionID, new SelectList(Enumerable.Empty<SelectListItem>(), "ID", "Sector"), new { @class = "form-control", id = "UbiSectorID" })
                        </div>
                    </div>

                    <div class="col-md-12 mb-3">
                        <div class="input-group">
                            <span class="input-group-text">Producto</span>
                            @Html.DropDownListFor(Model => Model.ConceptoID, new SelectList(conceptos, "ID", "Concepto"), new { @class = "form-select", id = "ConceptoID" })
                        </div>
                    </div>

                    <div class="col-md-12 mb-3">
                        <div class="input-group">
                            <span class="input-group-text">Stock</span>
                            @Html.TextBoxFor(Model => Model.Stock, new { @class = "form-control", id = "Stock", type = "number" })
                        </div>
                    </div>

                    <div class="input-group mb-3">
                        @Html.DropDownListFor(m => m.TipoMonedaID, new SelectList(tipoMonedas, "ID", "TipoMoneda", 1), "Tipo Moneda", new { @class = "form-control col-3", })
                        @Html.TextBoxFor(m => m.Precio, new { @class = "form-control col-9 Precio", placeholder = "Ingrese precio" })
                    </div>

                    <div class="form-check form-switch form-check-reverse">
                        <label class="form-check-label" for="flexSwitchCheckDefault">Activar</label>
                        @Html.CheckBoxFor(Model => Model.IsActive, new { @class = "form-check-input", role = "switch", id = "flexSwitchCheckDefault" })
                    </div>
                }
                <div class="col-md-12 mb-3">
                    <div class="input-group">
                        <span class="input-group-text">Servicio</span>
                        @Html.DropDownList("ServicioID", new SelectList(servicios, "ID", "Servicio", "Categoria"), "Seleccionar servicio", new { @class = "form-select", id = "ServicioID" })
                        <button type="button" class="btn btn-primary" id="addServiceBtn">Agregar Servicio</button>
                    </div>
                </div>

                <table class="table" id="servicesTable">
                    <thead>
                        <tr>
                            <th>Servicio</th>
                            <th>Tipo Moneda</th>
                            <th>Precio</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                    </tbody>
                </table>

            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-primary" id="submitButton">Guardar</button>
            </div>
        </div>
    </div>
</div>
<script>
    $(document).ready(function () {
        showLoading(false);

        $("#createSeccionConcepto").modal('show');

        $('#CementerioID').on("change", function () {
            changeSelectCascade(GetPatiosByCementerioId, $(this).val(), $('#UbiPatioID'))
        }).trigger('change');

        $('#UbiPatioID').on("change", function () {
            changeSelectCascade(GetSectoresByIdAsync, $(this).val(), $('#UbiSectorID'))
        });

        // ======== Función general: formato chileno ======== //
        function formatChileanNumber(input, allowDecimals) {
            let value = input.replace(/\./g, '').replace(/,/g, '.');

            // Solo números o números con un punto decimal
            if (!allowDecimals) {
                value = value.replace(/[^0-9]/g, '');
            } else {
                value = value.replace(/[^0-9.]/g, '').replace(/(\..*?)\..*/g, '$1');
            }

            if (value === '') return '';

            let parts = value.split('.');
            let integerPart = parts[0];
            let decimalPart = parts.length > 1 ? ',' + parts[1].substring(0, 2) : '';

            // Agregar separadores de miles
            integerPart = integerPart.replace(/\B(?=(\d{3})+(?!\d))/g, '.');

            return integerPart + decimalPart;
        }

        // ======== Campo principal Precio ======== //
        $(document).on('input', '.Precio', function () {
            let tipoMonedaText = $('#TipoMonedaID option:selected').text().trim().toUpperCase();
            let allowDecimals = tipoMonedaText !== 'CLP';
            $(this).val(formatChileanNumber($(this).val(), allowDecimals));
        });

        // ======== Servicios dinámicos ======== //
        $('#addServiceBtn').on('click', function () {
            var selectedServiceText = $('#ServicioID option:selected').text();
            var selectedServiceId = $('#ServicioID').val();

            if (selectedServiceId) {
                var serviceExists = $('#servicesTable tbody tr').filter(function () {
                    return $(this).data('service-id') == selectedServiceId;
                }).length > 0;

                if (serviceExists) {
                    showToast("info", "Este servicio ya está agregado.");
                    return;
                }

                var newRow = $(`
                    <tr data-service-id="${selectedServiceId}">
                        <td>${selectedServiceText}</td>
                        <td>
                            <select class="form-control service-tipo-moneda-id">
                                @foreach (var item in tipoMonedas)
                                {
                                    <option value="@item.ID">@item.TipoMoneda</option>
                                }
                            </select>
                        </td>
                        <td><input type="text" class="form-control service-price Precio" placeholder="Asignar precio"></td>
                        <td><button type="button" class="btn btn-danger removeServiceBtn">Eliminar</button></td>
                    </tr>
                `);

                $('#servicesTable tbody').append(newRow);
            }
        });

        // ======== Formateo dinámico en los servicios ======== //
        $(document).on('input', '.service-price', function () {
            let row = $(this).closest('tr');
            let tipoMonedaText = row.find('.service-tipo-moneda-id option:selected').text().trim().toUpperCase();
            let allowDecimals = tipoMonedaText !== 'CLP';
            $(this).val(formatChileanNumber($(this).val(), allowDecimals));
        });

        $(document).on('change', '.service-tipo-moneda-id', function () {
            let row = $(this).closest('tr');
            let tipoMonedaText = $(this).find('option:selected').text().trim().toUpperCase();
            let allowDecimals = tipoMonedaText !== 'CLP';
            let priceInput = row.find('.service-price');
            priceInput.val(formatChileanNumber(priceInput.val(), allowDecimals));
        });

        $('#servicesTable').on('click', '.removeServiceBtn', function () {
            $(this).closest('tr').remove();
        });

        // ======== Envío del formulario ======== //
        $('#submitButton').click(function () {
            showLoading(true);

            $('#createSeccionConceptoForm').find('input[name^="ServicioRequests"]').remove();

            $('#servicesTable tbody tr').each(function (index) {
                var serviceId = $(this).data('service-id');
                var price = $(this).find('.service-price').val();
                var tipoMonedaId = $(this).find('.service-tipo-moneda-id').val();

                // Convertir formato chileno a número normal
                price = price.replace(/\./g, '');

                $('<input>').attr({
                    type: 'hidden',
                    name: `ServicioRequests[${index}].ServicioID`
                }).val(serviceId).appendTo('#createSeccionConceptoForm');

                $('<input>').attr({
                    type: 'hidden',
                    name: `ServicioRequests[${index}].TipoMonedaID`
                }).val(tipoMonedaId).appendTo('#createSeccionConceptoForm');

                $('<input>').attr({
                    type: 'hidden',
                    name: `ServicioRequests[${index}].Precio`
                }).val(price).appendTo('#createSeccionConceptoForm');
            });

            // Convertir precio principal a formato numérico estándar
            $('#Precio').val($('#Precio').val().replace(/\./g, ''));

            var formData = $('#createSeccionConceptoForm').serialize();

            $.ajax({
                url: CreateSeccionConcepto,
                type: 'Post',
                data: formData,
                success: function (response) {
                    if (response.success) {
                        showToast("success", response.message);
                        $("#createSeccionConcepto").modal('hide');
                        $("#patiosGrid").data("kendoGrid").dataSource.read();
                    } else {
                        showToast("info", response.message);
                    }
                    showLoading(false);
                },
                error: function () {
                    showLoading(false);
                    showToast("error", "Ocurrió un error al procesar la solicitud.");
                }
            });
        });
    });
</script>
