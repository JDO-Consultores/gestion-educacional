<div class="toast-container position-fixed top-0 end-0 p-3" style="z-index: 10001">
    <div class="toast" role="alert" aria-live="assertive" aria-atomic="true" id="myToast" data-bs-delay="5000">
        <div class="toast-body">
            <span class="content" id="respuesta"></span>
        </div>
    </div>
</div>

<style>
    .toast {
        font-size: 1rem; /* Tamaño de la fuente */
        padding: 10px; /* Espaciado dentro del toast */
        width: auto; /* Deja que el ancho se ajuste al contenido */
        max-width: 100%; /* Evita que el toast se salga de la pantalla */
        white-space: nowrap; /* Evita que el texto se divida en varias líneas */
    }

        .toast .toast-body .content {
            color: black !important; /* Texto negro */
            text-transform: uppercase;
            font-weight: bold;
            font-size: 1rem; /* Tamaño del texto */
            white-space: nowrap; /* Evita el wrap del texto */
            overflow: hidden; /* Evita que el texto se desborde */
            display: block; /* Asegura que el texto ocupe el espacio disponible */
        }
</style>