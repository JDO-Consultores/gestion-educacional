@{
    Layout = "~/Views/Shared/_LayoutError.cshtml";
    ViewBag.Title = "Algo salió mal";
}

<div class="error-icon" style="background: rgba(241, 160, 242, 0.18); color: #d46fd6;">
    <i class="bi bi-exclamation-triangle"></i>
</div>

<div class="error-code">Error 500</div>
<h1 class="error-title">Ups, algo salió mal</h1>
<p class="error-text">
    Ocurrió un problema inesperado al procesar su solicitud.
    Nuestro equipo ha sido notificado. Por favor, intente nuevamente en unos
    instantes o vuelva a la página principal.
</p>

<div class="error-actions">
    <a href="@Url.Action("Dashboard", "Home")" class="btn-error btn-error-primary">
        <i class="bi bi-house-door"></i> Ir al inicio
    </a>
    <a href="javascript:history.back()" class="btn-error btn-error-ghost">
        <i class="bi bi-arrow-left"></i> Volver atrás
    </a>
</div>
