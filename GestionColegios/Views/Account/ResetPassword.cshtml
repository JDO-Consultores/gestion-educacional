@model  GestionColegios.Models.ResetPasswordViewModel
@{
    Layout = "~/Views/Shared/_LayoutLogin.cshtml";
}

<section class="ftco-section">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-6 col-lg-5">
                <div class="login-wrap p-4 p-md-5">
                    <div class="icon d-flex align-items-center justify-content-center">
                        <img src="~/Content/Assets/Logos/png/logo_300x300.png" alt="Login Image" class="img-fluid">
                    </div>
                    <h3 class="text-center mb-4">Ingrese su nueva contraseña!</h3>
                    @using (Html.BeginForm("ResetPassword", "Account", FormMethod.Post))
                    {
                        @Html.AntiForgeryToken()
                        @Html.HiddenFor(m => m.Token)
                        <div class="form-group">
                            <div class="form-group">
                                @Html.LabelFor(m => m.Password, "Nueva contraseña")
                                @Html.PasswordFor(m => m.Password, new { @class = "form-control" })
                                @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <div class="form-group">
                            @Html.LabelFor(m => m.PasswordConfirm, "Confirmar contraseña")
                            @Html.PasswordFor(m => m.PasswordConfirm, new { @class = "form-control" })
                            @Html.ValidationMessageFor(m => m.PasswordConfirm, "", new { @class = "text-danger" })
                        </div>

                        @Html.ValidationMessageFor(m => m.Token, "", new { @class = "text-danger" })

                        if (ViewBag.Message != null)
                        {
                            <div class="alert alert-info mt-3">
                                @ViewBag.Message
                            </div>
                        }
                        <div class="form-group">
                            <button type="submit" class="btn btn-primary rounded submit p-3 px-5">Cambiar contraseña!</button>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</section>