@model GestionColegios.Responses.UserResponse

<div class="modal fade" id="editUser" tabindex="-1" aria-labelledby="editModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="editModalLabel">Editar Usuario</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                @using (Html.BeginForm("EditUserAsync", "Users", FormMethod.Post, new { id = "editUserForm" }))
                {
                    @Html.AntiForgeryToken();
                    @Html.HiddenFor(Model => Model.ID)

                    <div class="col-md-12 mb-3">
                        <div class="input-group">
                            <span class="input-group-text">Username</span>
                            @Html.TextBoxFor(Model => Model.Username, new { @class = "form-control", id = "Username", type = "email", @readonly = "readonly" })
                        </div>
                        <span class="form-text">El correo (username) no se puede modificar.</span>
                    </div>

                    <div class="col-md-12 mb-3">
                        <div class="input-group">
                            <span class="input-group-text">Nombre</span>
                            @Html.TextBoxFor(Model => Model.Nombre, new { @class = "form-control", id = "Nombre" })
                        </div>
                    </div>

                    <div class="col-md-12 mb-3">
                        <div class="input-group">
                            <span class="input-group-text">Apellido</span>
                            @Html.TextBoxFor(Model => Model.Apellido, new { @class = "form-control", id = "Apellido" })
                        </div>
                    </div>

                    <div class="col-md-12 mb-3">
                        <div class="input-group">
                            <div class="form-check form-switch form-check-reverse">
                                @Html.CheckBoxFor(Model => Model.IsActive, new { id = "IsActive", @class = "form-check-input", type = "checkbox", name = "IsActive" })
                                <label class="form-check-label" for="IsActive">¿Usuario Habilitado?</label>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-12 mb-3">
                        <div class="input-group">
                            <div class="form-check form-switch form-check-reverse">
                                @Html.CheckBoxFor(Model => Model.IsAdmin, new { id = "IsAdmin", @class = "form-check-input", type = "checkbox", name = "IsAdmin" })
                                <label class="form-check-label" for="IsAdmin">¿Permisos de administrador?</label>
                            </div>
                        </div>
                    </div>

                    <hr />
                    <p class="text-muted small mb-2">
                        <i class="bi bi-info-circle me-1"></i>
                        Deje los campos de contraseña en blanco para mantener la actual.
                    </p>

                    <div class="col-md-12 mb-3">
                        <div class="input-group">
                            <span class="input-group-text">Nueva Contraseña</span>
                            @Html.TextBoxFor(Model => Model.Password, new { @class = "form-control", id = "Password", type = "password", autocomplete = "new-password", style = "text-transform: none" })
                            <button type="button" class="btn btn-outline-secondary toggle-password" data-target="#Password" tabindex="-1" title="Mostrar/ocultar contraseña">
                                <i class="bi bi-eye"></i>
                            </button>
                        </div>
                    </div>

                    <div class="col-md-12 mb-3">
                        <div class="input-group">
                            <span class="input-group-text">Confirmar Contraseña</span>
                            @Html.TextBoxFor(Model => Model.PasswordConfirm, new { @class = "form-control", id = "PasswordConfirm", type = "password", autocomplete = "new-password", style = "text-transform: none" })
                            <button type="button" class="btn btn-outline-secondary toggle-password" data-target="#PasswordConfirm" tabindex="-1" title="Mostrar/ocultar contraseña">
                                <i class="bi bi-eye"></i>
                            </button>
                        </div>
                    </div>
                }
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-primary" id="submitButton">Guardar</button>
            </div>
        </div>
    </div>
</div>

<script>
    $(document).ready(function () {
        $("#editUser").modal('show');

        // Al cerrar el modal, limpiar el nodo y cualquier backdrop huérfano
        // (los modales se cargan dinámicamente en #modales vía AJAX).
        $("#editUser").on('hidden.bs.modal', function () {
            $(this).remove();
            limpiarBackdrops();
        });

        // Mostrar / ocultar contraseña (igual que en el login)
        $("#editUser").on('click', '.toggle-password', function () {
            var $input = $($(this).data('target'));
            var $icon = $(this).find('i');
            if ($input.attr('type') === 'password') {
                $input.attr('type', 'text');
                $icon.removeClass('bi-eye').addClass('bi-eye-slash');
            } else {
                $input.attr('type', 'password');
                $icon.removeClass('bi-eye-slash').addClass('bi-eye');
            }
        });

        $('#submitButton').click(function () {
            showLoading(true);
            var formData = $('#editUserForm').serialize();
            $.ajax({
                url: EditUserAsync,
                type: 'Post',
                data: formData,
                success: function (response) {
                    if (response.success) {
                        showToast("success", response.message);
                        $("#editUser").modal('hide');
                        $("#grid").data("kendoGrid").dataSource.read();
                    } else {
                        showToast("info", response.message);
                    }
                    showLoading(false);
                },
                error: function () {
                    showLoading(false);
                    showToast("error", "Ocurrió un error al procesar la solicitud.");
                }
            });
        });
    });
</script>
