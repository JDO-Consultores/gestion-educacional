@using GestionColegios.ViewModels
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Ayuda";
    var temas        = (IEnumerable<AyudaGrupoViewModel>)ViewBag.Temas;
    var topicInicial = (string)ViewBag.TopicInicial;
}

<style>
    /* Layout de la ayuda */
    .ayuda-wrapper { display: flex; gap: 1rem; min-height: calc(100vh - 220px); }
    .ayuda-sidebar {
        width: 320px; flex-shrink: 0;
        background: #f8f9fa; border: 1px solid #e9ecef; border-radius: .5rem;
        padding: .75rem; overflow-y: auto; max-height: calc(100vh - 220px);
        position: sticky; top: 70px;
    }
    .ayuda-content {
        flex: 1; background: #fff; border: 1px solid #e9ecef; border-radius: .5rem;
        padding: 1.5rem 2rem; overflow-x: auto;
    }
    .ayuda-sidebar h6 {
        font-size: .75rem; text-transform: uppercase; letter-spacing: .05em;
        color: #6c757d; margin: .85rem .25rem .25rem;
    }
    .ayuda-sidebar h6:first-child { margin-top: 0; }
    .ayuda-sidebar .ayuda-item {
        display: block; padding: .35rem .6rem; margin-bottom: .1rem;
        border-radius: .35rem; color: #495057; text-decoration: none;
        font-size: .9rem; cursor: pointer; border: none; background: transparent;
        width: 100%; text-align: left;
    }
    .ayuda-sidebar .ayuda-item:hover { background: #e9ecef; color: #212529; }
    .ayuda-sidebar .ayuda-item.active {
        background: #0d6efd; color: #fff; font-weight: 600;
    }
    .ayuda-sidebar .ayuda-item.hidden { display: none; }
    .ayuda-sidebar h6.hidden { display: none; }

    /* Markdown renderizado */
    .ayuda-content h1 { font-size: 1.8rem; margin-bottom: 1rem; padding-bottom: .5rem; border-bottom: 2px solid #e9ecef; }
    .ayuda-content h2 { font-size: 1.4rem; margin-top: 1.8rem; margin-bottom: .8rem; color: #0d6efd; }
    .ayuda-content h3 { font-size: 1.15rem; margin-top: 1.4rem; margin-bottom: .6rem; color: #495057; }
    .ayuda-content h4 { font-size: 1rem; margin-top: 1.2rem; margin-bottom: .5rem; }
    .ayuda-content p, .ayuda-content ul, .ayuda-content ol { line-height: 1.65; }
    .ayuda-content code {
        background: #f1f3f5; padding: 1px 6px; border-radius: 3px;
        font-size: .9em; color: #d6336c;
    }
    .ayuda-content pre {
        background: #212529; color: #f8f9fa; padding: 1rem; border-radius: .4rem;
        overflow-x: auto; font-size: .85rem; line-height: 1.5;
    }
    .ayuda-content pre code { background: transparent; color: inherit; padding: 0; }
    .ayuda-content table {
        width: 100%; border-collapse: collapse; margin: 1rem 0;
        font-size: .92rem;
    }
    .ayuda-content table th, .ayuda-content table td {
        border: 1px solid #dee2e6; padding: .5rem .75rem; text-align: left;
    }
    .ayuda-content table thead { background: #f1f3f5; }
    .ayuda-content blockquote {
        border-left: 4px solid #0d6efd; background: #f8f9fa;
        padding: .6rem 1rem; margin: 1rem 0; border-radius: 0 .35rem .35rem 0;
        color: #495057;
    }
    .ayuda-content hr { margin: 1.8rem 0; border-color: #e9ecef; }
    .ayuda-content a { color: #0d6efd; text-decoration: none; }
    .ayuda-content a:hover { text-decoration: underline; }
    .ayuda-content .ayuda-loading {
        text-align: center; padding: 3rem; color: #6c757d;
    }

    @@media (max-width: 768px) {
        .ayuda-wrapper { flex-direction: column; }
        .ayuda-sidebar { width: 100%; max-height: none; position: static; }
    }
</style>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0"><i class="bi bi-question-circle me-2 text-primary"></i>Centro de Ayuda</h2>
    <a href="@Url.Action("Dashboard", "Home")" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-arrow-left me-1"></i>Volver al inicio
    </a>
</div>

<div class="ayuda-wrapper">

    <!-- ??? Sidebar de temas ??? -->
    <aside class="ayuda-sidebar">
        <div class="mb-2">
            <div class="input-group input-group-sm">
                <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
                <input type="text" id="ayudaBuscar" class="form-control"
                       placeholder="Buscar tema..." autocomplete="off" />
            </div>
        </div>

        <div id="ayudaIndice">
            @foreach (var grupo in temas)
            {
                <h6 data-grupo="@grupo.Grupo">@grupo.Grupo</h6>
                foreach (var item in grupo.Items)
                {
                    <button type="button"
                            class="ayuda-item"
                            data-topic="@item.Archivo"
                            data-titulo="@item.Titulo"
                            data-grupo="@grupo.Grupo">
                        @item.Titulo
                    </button>
                }
            }
        </div>

        <hr class="my-2" />
        <div class="text-muted small px-2">
            <i class="bi bi-info-circle me-1"></i>
            ¿No encuentras lo que buscas? Contacta al administrador del sistema.
        </div>
    </aside>

    <!-- ??? Panel de contenido ??? -->
    <section class="ayuda-content" id="ayudaContenido">
        <div class="ayuda-loading">
            <div class="spinner-border text-primary" role="status"></div>
            <p class="mt-3 mb-0">Cargando ayuda...</p>
        </div>
    </section>

</div>

@section scripts {
<script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
<script>
(function () {
    var $contenido = $("#ayudaContenido");
    var $indice    = $("#ayudaIndice");
    var $buscar    = $("#ayudaBuscar");
    var topicActual = null;

    // Configurar marked: encabezados con id automático para anclas
    if (window.marked && marked.setOptions) {
        marked.setOptions({ gfm: true, breaks: false, headerIds: true });
    }

    function cargarTopic(topic, titulo) {
        if (!topic || topic === topicActual) return;
        topicActual = topic;

        // Marcar item activo
        $indice.find(".ayuda-item").removeClass("active");
        $indice.find('.ayuda-item[data-topic="' + topic + '"]').addClass("active");

        // Actualizar URL sin recargar
        if (history.replaceState) {
            history.replaceState(null, "", "?topic=" + encodeURIComponent(topic));
        }

        $contenido.html(
            '<div class="ayuda-loading">' +
            '<div class="spinner-border text-primary" role="status"></div>' +
            '<p class="mt-3 mb-0">Cargando "' + (titulo || topic) + '"...</p>' +
            '</div>'
        );

        $.get('@Url.Action("AyudaContenido", "Home")', { topic: topic })
            .done(function (md) {
                var html = window.marked ? marked.parse(md) : '<pre>' + md + '</pre>';
                $contenido.html(html);

                // Interceptar enlaces internos a otros .md para abrirlos dentro
                $contenido.find('a[href$=".md"]').each(function () {
                    var $a = $(this);
                    var href = $a.attr('href');
                    // tomar solo el nombre del archivo (último segmento)
                    var nombre = href.split('/').pop().split('#')[0];
                    $a.attr('href', '#').on('click', function (e) {
                        e.preventDefault();
                        var btn = $indice.find('.ayuda-item[data-topic="' + nombre + '"]');
                        if (btn.length) cargarTopic(nombre, btn.data('titulo'));
                    });
                });

                $contenido.scrollTop(0);
                window.scrollTo({ top: 0, behavior: 'smooth' });
            })
            .fail(function () {
                $contenido.html(
                    '<div class="alert alert-warning">' +
                    '<i class="bi bi-exclamation-triangle me-2"></i>' +
                    'No se pudo cargar el contenido de ayuda.' +
                    '</div>'
                );
            });
    }

    // Click en un tema
    $indice.on('click', '.ayuda-item', function () {
        cargarTopic($(this).data('topic'), $(this).data('titulo'));
    });

    // Buscador del índice
    $buscar.on('input', function () {
        var q = ($(this).val() || '').toLowerCase().trim();
        var gruposVisibles = {};

        $indice.find('.ayuda-item').each(function () {
            var $btn   = $(this);
            var texto  = ($btn.data('titulo') || '').toLowerCase();
            var visible = !q || texto.indexOf(q) !== -1;
            $btn.toggleClass('hidden', !visible);
            if (visible) gruposVisibles[$btn.data('grupo')] = true;
        });

        $indice.find('h6').each(function () {
            var grupo = $(this).data('grupo');
            $(this).toggleClass('hidden', !gruposVisibles[grupo]);
        });
    });

    // Carga inicial
    cargarTopic('@topicInicial', null);
})();
</script>
}
