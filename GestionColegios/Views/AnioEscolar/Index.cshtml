@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Años Escolares";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2><i class="bi bi-calendar3 me-2"></i>Años Escolares</h2>
    @if ((bool)ViewBag.IsAdmin)
    {
        <a href="@Url.Action("Crear", "AnioEscolar")" class="btn btn-primary">
            <i class="bi bi-plus-circle me-1"></i> Nuevo Año Escolar
        </a>
    }
</div>

<div id="gridAniosEscolares"></div>

@section scripts {
<script>
$(document).ready(function () {

    $("#gridAniosEscolares").kendoGrid({
        dataSource: {
            type: "json",
            transport: {
                read: {
                    url: "@Url.Action("GetAniosEscolares", "AnioEscolar")",
                    contentType: "application/json",
                    type: "POST"
                },
                parameterMap: function (options) {
                    return kendo.stringify(options);
                }
            },
            pageSize: 10,
            serverPaging: true,
            serverSorting: true,
            schema: {
                model: {
                    id: "ID",
                    fields: {
                        Anio:             { type: "number" },
                        Establecimiento:  { type: "string" },
                        FechaInicio:      { type: "date" },
                        FechaTermino:     { type: "date" },
                        Cerrado:          { type: "boolean" },
                        TotalCursos:      { type: "number" },
                        TotalMatriculados:{ type: "number" }
                    }
                },
                data: "Data",
                total: "Total"
            }
        },
        pageable: { refresh: true, pageSizes: [10, 20, 50] },
        sortable: true,
        resizable: true,
        columns: [
            { field: "Anio",              title: "Año",          width: "80px" },
            { field: "Establecimiento",   title: "Establecimiento" },
            { field: "FechaInicio",       title: "Inicio",       width: "110px", format: "{0:dd/MM/yyyy}" },
            { field: "FechaTermino",      title: "Término",      width: "110px", format: "{0:dd/MM/yyyy}" },
            { field: "TotalCursos",       title: "Cursos",       width: "80px",  attributes: { style: "text-align:center" } },
            { field: "TotalMatriculados", title: "Matriculados", width: "110px", attributes: { style: "text-align:center" } },
            {
                field: "Cerrado",
                title: "Estado",
                width: "120px",
                template: function(item) {
                    if (item.EsActivo)
                        return '<span class="badge bg-primary"><i class="bi bi-star-fill me-1"></i>Activo</span>';
                    if (item.Cerrado)
                        return '<span class="badge bg-secondary">Cerrado</span>';
                    return '<span class="badge bg-success bg-opacity-50 text-success">Abierto</span>';
                }
            },
            {
                title: "Acciones",
                width: "200px",
                attributes: { style: "text-align:center" },
                template: function (item) {
                    var btns = '<a class="btn btn-outline-primary btn-sm me-1" href="@Url.Action("Detalle","AnioEscolar")/' + item.ID + '" title="Ver detalle">' +
                               '<i class="bi bi-eye"></i></a>';
                    btns += '<a class="btn btn-outline-secondary btn-sm me-1" href="@Url.Action("Editar","AnioEscolar")/' + item.ID + '" title="Editar">' +
                            '<i class="bi bi-pencil"></i></a>';
                    if (!item.Cerrado && !item.EsActivo) {
                        btns += '<button class="btn btn-outline-success btn-sm me-1 btn-marcar-activo" data-id="' + item.ID + '" data-anio="' + item.Anio + '" ' +
                                'title="Marcar como Activo"><i class="bi bi-star"></i></button>';
                    }
                    btns += '<button class="btn btn-outline-warning btn-sm btn-cerrar-anio" data-id="' + item.ID + '" ' +
                            'title="' + (item.Cerrado ? "Reabrir" : "Cerrar") + '">' +
                            '<i class="bi ' + (item.Cerrado ? 'bi-unlock' : 'bi-lock') + '"></i></button>';
                    return btns;
                }
            }
        ]
    });

    // Cerrar / Reabrir año
    $(document).on("click", ".btn-cerrar-anio", function () {
        var id     = $(this).data("id");
        var accion = $(this).attr("title");
        showConfirm({
            tipo: 'warning',
            titulo: accion + ' año escolar',
            mensaje: 'Desea ' + accion.toLowerCase() + ' este año escolar?',
            onOk: function () {
                $.post("@Url.Action("CerrarReabrir", "AnioEscolar")", { id: id })
                    .done(function (r) {
                        if (r.success) {
                            showToast("success", "Operacion realizada correctamente.");
                            $("#gridAniosEscolares").data("kendoGrid").dataSource.read();
                        } else {
                            showToast("error", "No se pudo completar la operacion.");
                        }
                    });
            }
        });
    });

    // Marcar como Activo
    $(document).on("click", ".btn-marcar-activo", function () {
        var id   = $(this).data("id");
        var anio = $(this).data("anio");
        showConfirm({
            tipo: 'primary',
            titulo: 'Marcar año activo',
            mensaje: 'Confirma marcar el año <strong>' + anio + '</strong> como el año escolar activo del sistema? El año activo anterior perderá esa marca.',
            onOk: function () {
                $.post("@Url.Action("MarcarActivo", "AnioEscolar")", { id: id })
                    .done(function (r) {
                        if (r.success) {
                            showToast("success", "Año " + anio + " marcado como activo.");
                            $("#gridAniosEscolares").data("kendoGrid").dataSource.read();
                        } else {
                            showToast("error", r.message || "No se pudo completar la operación.");
                        }
                    });
            }
        });
    });
});
</script>
}
