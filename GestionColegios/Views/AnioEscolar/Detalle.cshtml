@model GestionColegios.ViewModels.AnioEscolarDetalleViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Detalle Año Escolar " + Model.Anio;
    bool isAdmin = (bool)ViewBag.IsAdmin;
}

<!-- Cabecera -->
<div class="d-flex justify-content-between align-items-start mb-3">
    <div>
        <h3 class="mb-0">
            <i class="bi bi-calendar3 me-2"></i>Año Escolar @Model.Anio
        </h3>
        <small class="text-muted">@Model.Establecimiento</small>
    </div>
    <div class="d-flex gap-2">
        @if (isAdmin)
        {
            <a href="@Url.Action("Editar", "AnioEscolar", new { id = Model.ID })"
               class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-pencil"></i> Editar
            </a>
            <a href="@Url.Action("Promocion", "AnioEscolar", new { id = Model.ID })"
               class="btn btn-outline-primary btn-sm">
                <i class="bi bi-mortarboard me-1"></i> Cierre / Promoción
            </a>
            <button id="btnCerrarReabrir"
                    class="btn btn-sm @(Model.Cerrado ? "btn-outline-success" : "btn-outline-warning")"
                    data-id="@Model.ID" data-cerrado="@Model.Cerrado.ToString().ToLower()">
                <i class="bi @(Model.Cerrado ? "bi-unlock" : "bi-lock") me-1"></i>
                @(Model.Cerrado ? "Reabrir año" : "Cerrar año")
            </button>
        }
        <a href="@Url.Action("Index", "AnioEscolar")" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left"></i> Volver
        </a>
    </div>
</div>

<!-- Resumen -->
<div class="row g-3 mb-3">
    <div class="col-md-3">
        <div class="card border-0 bg-light text-center py-2">
            <div class="fs-4 fw-bold text-primary">@Model.Cursos.Count</div>
            <div class="small text-muted">Cursos</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 bg-light text-center py-2">
            <div class="fs-4 fw-bold text-success">@Model.Cursos.Sum(c => c.TotalAlumnos)</div>
            <div class="small text-muted">Alumnos matriculados</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 bg-light text-center py-2">
            <div class="fs-4 fw-bold text-info">
                @(Model.FechaInicio.HasValue ? Model.FechaInicio.Value.ToString("dd/MM/yyyy") : "—")
            </div>
            <div class="small text-muted">Fecha inicio</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 bg-light text-center py-2">
            <div class="fs-4 fw-bold text-secondary">
                @(Model.FechaTermino.HasValue ? Model.FechaTermino.Value.ToString("dd/MM/yyyy") : "—")
            </div>
            <div class="small text-muted">Fecha término</div>
        </div>
    </div>
</div>

<!-- Tabla de cursos -->
<div class="card shadow-sm">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h6 class="mb-0"><i class="bi bi-book me-2"></i>Cursos del año @Model.Anio</h6>
        @if (isAdmin && !Model.Cerrado)
        {
            <a href="@Url.Action("CrearCurso", "AnioEscolar", new { anioEscolarId = Model.ID })"
               class="btn btn-primary btn-sm">
                <i class="bi bi-plus-circle me-1"></i> Agregar Curso
            </a>
        }
    </div>
    <div class="card-body p-0">
        @if (!Model.Cursos.Any())
        {
            <p class="text-center text-muted py-4">No hay cursos registrados para este año.</p>
        }
        else
        {
            foreach (var nivel in Model.Cursos.GroupBy(c => c.NivelEnsenanza).OrderBy(g => g.Key))
            {
                <div class="px-3 pt-3">
                    <h6 class="text-muted border-bottom pb-1">
                        <i class="bi bi-mortarboard me-1"></i>@nivel.Key
                    </h6>
                </div>
                <table class="table table-sm table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th style="width:150px">Grado</th>
                            <th style="width:80px">Letra</th>
                            <th style="width:100px" class="text-center">Capacidad</th>
                            <th style="width:110px" class="text-center">Matriculados</th>
                            <th>Profesor Jefe</th>
                            @if (isAdmin && !Model.Cerrado)
                            {
                                <th style="width:120px" class="text-center">Acciones</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var curso in nivel.OrderBy(c => c.Grado).ThenBy(c => c.Letra))
                        {
                            <tr>
                                <td class="fw-semibold">@curso.Grado</td>
                                <td>@curso.Letra</td>
                                <td class="text-center">@(curso.Capacidad?.ToString() ?? "—")</td>
                                <td class="text-center">
                                    <span class="badge @(curso.TotalAlumnos >= (curso.Capacidad ?? int.MaxValue) ? "bg-danger" : "bg-success")">
                                        @curso.TotalAlumnos
                                    </span>
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(curso.ProfesorJefe))
                                    {
                                        <i class="bi bi-person-check text-success me-1"></i>@curso.ProfesorJefe
                                    }
                                    else
                                    {
                                        <span class="text-muted small"><i class="bi bi-person-dash me-1"></i>Sin asignar</span>
                                    }
                                </td>
                                @if (isAdmin && !Model.Cerrado)
                                {
                                    <td class="text-center">
                                        <a href="@Url.Action("EditarCurso", "AnioEscolar", new { id = curso.ID })"
                                           class="btn btn-outline-secondary btn-sm me-1" title="Editar">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <button class="btn btn-outline-danger btn-sm btn-eliminar-curso"
                                                data-id="@curso.ID" title="Eliminar"
                                                data-bs-toggle="tooltip" data-bs-placement="top">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            }
        }
    </div>
</div>

@section scripts {
<script>
var anioEscolarId = @Model.ID;

// Cerrar / Reabrir año
$("#btnCerrarReabrir").click(function () {
    var cerrado = $(this).data("cerrado") === true || $(this).data("cerrado") === "true";
    var accion = cerrado ? "reabrir" : "cerrar";
    showConfirm({
        tipo: cerrado ? 'info' : 'warning',
        titulo: (cerrado ? 'Reabrir' : 'Cerrar') + ' ano escolar',
        mensaje: 'Desea ' + accion + ' el ano escolar @Model.Anio?',
        onOk: function () {
            $.post("@Url.Action("CerrarReabrir", "AnioEscolar")", { id: anioEscolarId })
                .done(function (r) {
                    if (r.success) { location.reload(); }
                    else { showToast("error", "No se pudo completar la operacion."); }
                });
        }
    });
});

// Eliminar curso
$(document).on("click", ".btn-eliminar-curso", function () {
    var id = $(this).data("id");
    showConfirm({
        tipo: 'danger',
        titulo: 'Eliminar curso',
        mensaje: 'El curso sera eliminado. No debe tener alumnos matriculados.',
        onOk: function () {
            $.post("@Url.Action("EliminarCurso", "AnioEscolar")", { cursoId: id })
                .done(function (r) {
                    if (r.success) {
                        showToast("success", r.message);
                        setTimeout(function () { location.reload(); }, 800);
                    } else {
                        showToast("error", r.message);
                    }
                });
        }
    });
});
</script>
}
