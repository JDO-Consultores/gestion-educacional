@model GestionColegios.ViewModels.CursoFormViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    bool esNuevo = Model.ID == 0;
    ViewBag.Title = esNuevo ? "Nuevo Curso" : "Editar Curso";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3>
        <i class="bi bi-book me-2"></i>
        @(esNuevo ? "Nuevo Curso" : "Editar Curso") — Año @Model.AnioEscolar
    </h3>
</div>

@using (Html.BeginForm(esNuevo ? "CrearCurso" : "EditarCurso", "AnioEscolar",
        FormMethod.Post, new { id = "formCurso" }))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(m => m.ID)
    @Html.HiddenFor(m => m.AnioEscolarID)
    @Html.HiddenFor(m => m.AnioEscolar)

    <div class="card shadow-sm">
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-5">
                    <label class="form-label">Grado <span class="text-danger">*</span></label>
                    <select name="GradoID" id="ddlGrado" class="form-select">
                        <option value="">-- Seleccione --</option>
                        @foreach (var g in Model.Grados)
                        {
                            <option value="@g.ID" @(Model.GradoID == g.ID ? "selected" : "")>@g.Texto</option>
                        }
                    </select>
                    @Html.ValidationMessageFor(m => m.GradoID, "", new { @class = "text-danger small" })
                </div>
                <div class="col-md-2">
                    <label class="form-label">Letra <span class="text-danger">*</span></label>
                    @Html.TextBoxFor(m => m.Letra, new { @class = "form-control text-uppercase", maxlength = "2", placeholder = "A" })
                    @Html.ValidationMessageFor(m => m.Letra, "", new { @class = "text-danger small" })
                </div>
                <div class="col-md-3">
                    <label class="form-label">Capacidad máxima</label>
                    @Html.TextBoxFor(m => m.Capacidad, new { @class = "form-control", type = "number", min = "1", max = "500", placeholder = "45" })
                    @Html.ValidationMessageFor(m => m.Capacidad, "", new { @class = "text-danger small" })
                </div>
                <div class="col-md-8">
                    <label class="form-label">Profesor Jefe</label>
                    <select name="ProfesorJefeID" id="ddlProfesorJefe" class="form-select">
                        <option value="">-- Sin asignar --</option>
                        @foreach (var p in Model.Profesores)
                        {
                            <option value="@p.ID" @(Model.ProfesorJefeID == p.ID ? "selected" : "")>@p.Texto</option>
                        }
                    </select>
                </div>
            </div>
        </div>
        <div class="card-footer d-flex justify-content-center gap-3">
            <a href="@Url.Action("Detalle", "AnioEscolar", new { id = Model.AnioEscolarID })"
               class="btn btn-outline-secondary">Cancelar</a>
            <button type="button" class="btn btn-primary" id="btnGuardarCurso">
                <i class="bi bi-save me-1"></i> Guardar
            </button>
        </div>
    </div>
}

@section scripts {
<script>
$(document).ready(function () {
    // Forzar mayúscula en la letra
    $('#Letra').on('input', function () {
        $(this).val($(this).val().toUpperCase());
    });

    $("#btnGuardarCurso").click(function () {
        var grado = $('#ddlGrado').val();
        var letra = $.trim($('#Letra').val());
        if (!grado) { showToast('info', 'Seleccione el grado.'); return; }
        if (!letra)  { showToast('info', 'Ingrese la letra del curso.'); return; }

        showLoading(true);
        $.ajax({
            url: $("#formCurso").attr("action"),
            type: "POST",
            data: $("#formCurso").serialize(),
            success: function (r) {
                if (r.success) {
                    showToast("success", r.message);
                    window.location.href = r.redirectUrl;
                } else {
                    showToast("error", r.message);
                    showLoading(false);
                }
            },
            error: function () {
                showLoading(false);
                showToast("error", "Error al procesar la solicitud.");
            }
        });
    });
});
</script>
}
