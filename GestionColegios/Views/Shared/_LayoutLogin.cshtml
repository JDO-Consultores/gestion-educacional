<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>GESTIÓN EDUCACIONAL</title>
    <link rel="stylesheet" href="~/Content/bootstrap.css" />
    <link rel="stylesheet" href="~/Content/SiteLogin.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link href="https://fonts.googleapis.com/css?family=Lato:300,400,700&amp;display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/font-awesome/4.7.0/css/font-awesome.min.css">
    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    @Scripts.Render("~/bundles/modernizr")
    <script src="~/Scripts/global.js" type="text/javascript"></script>
    <script src="~/Scripts/kendo/kendo.all.min.js" type="text/javascript"></script>
    <link rel="stylesheet" href="~/Content/kendo/kendo.default-main.css" />
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/4.3.136/pdf.mjs" type="module"></script>
    <script src="~/Scripts/kendo-ui-license.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/4.3.136/pdf.worker.mjs" type="module"></script>
    <link rel="icon" type="image/svg+xml" href="~/Content/Assets/logo_icono_sin_texto.ico">
    <link rel="shortcut icon" type="image/x-icon" href="~/Content/Assets/logo_icono_sin_texto.ico">
</head>
<body class="d-flex flex-column min-vh-100">
    <div id="modalUtilities"></div>
    @RenderBody()
    <footer class="bg-light border-top mt-auto py-3">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-md-6 d-flex align-items-center justify-content-center justify-content-md-start gap-2 mb-2 mb-md-0">
                    <img src="~/Content/Asset/logo_web_con_texto.png" alt="GestiónEducacional" style="height:34px; width:auto;">
                </div>
                <div class="col-md-6 text-md-end text-center">
                    <small class="text-muted">
                        &copy; 2026. Desarrollado por
                        <a href="https://jdoconsultores.cl/" target="_blank" class="text-decoration-none text-muted fw-medium">JDOConsultores</a>
                    </small>
                </div>
            </div>
        </div>
    </footer>
    <script>
        $(document).ready(function () {
            var _LoadingModal = '@Url.Action("_Utilities", "Default")';
            loadView($("#modalUtilities"), _LoadingModal);
        });
    </script>
</body>
</html>
