@model GestionColegios.ViewModels.AlumnoFichaViewModel

@* ── Estilos específicos del formulario ──────────────────────────────── *@
<style>
    .form-section {
        border-left: 4px solid transparent;
        border-radius: .5rem;
        padding: 1rem 1.25rem .75rem;
        background: #fafafa;
        margin-bottom: 1rem;
    }
    .form-section.sec-identificacion { border-left-color: #0d6efd; }
    .form-section.sec-contacto       { border-left-color: #40BF3B; }
    .form-section.sec-salud          { border-left-color: #dc3545; }
    .form-section.sec-social         { border-left-color: #F29F05; }
    .form-section.sec-estado         { border-left-color: #6c757d; }
    .form-section .sec-title {
        font-size: .8rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .06em;
        margin-bottom: .75rem;
        display: flex;
        align-items: center;
        gap: .4rem;
        color: #495057;
    }
    .form-label { font-size: .85rem; font-weight: 500; margin-bottom: .25rem; }
    .req { color: #dc3545; margin-left: 2px; }
</style>

@* ══════════════════════════════════════════════════════════════════════
   SECCIÓN 1 — IDENTIFICACIÓN
   ══════════════════════════════════════════════════════════════════════ *@
<div class="form-section sec-identificacion">
    <p class="sec-title"><i class="bi bi-person-vcard-fill"></i> Identificación</p>
    <div class="row g-3">
        <div class="col-md-2">
            <label class="form-label">RUT <span class="req">*</span></label>
            @Html.TextBoxFor(m => m.Rut, new { @class = "form-control", placeholder = "12.345.678-9", id = "txtRut", autocomplete = "off" })
            <div id="rutFeedback" class="small mt-1"></div>
            @Html.ValidationMessageFor(m => m.Rut, "", new { @class = "text-danger small" })
        </div>
        <div class="col-md-3">
            <label class="form-label">Apellido Paterno <span class="req">*</span></label>
            @Html.TextBoxFor(m => m.ApellidoPaterno, new { @class = "form-control", placeholder = "Apellido paterno" })
            @Html.ValidationMessageFor(m => m.ApellidoPaterno, "", new { @class = "text-danger small" })
        </div>
        <div class="col-md-3">
            <label class="form-label">Apellido Materno</label>
            @Html.TextBoxFor(m => m.ApellidoMaterno, new { @class = "form-control", placeholder = "Apellido materno" })
        </div>
        <div class="col-md-4">
            <label class="form-label">Nombres <span class="req">*</span></label>
            @Html.TextBoxFor(m => m.Nombres, new { @class = "form-control", placeholder = "Nombres completos" })
            @Html.ValidationMessageFor(m => m.Nombres, "", new { @class = "text-danger small" })
        </div>
        <div class="col-md-2">
            <label class="form-label">Fecha de Nacimiento <span class="req">*</span></label>
            @Html.TextBoxFor(m => m.FechaNacimiento, "{0:dd/MM/yyyy}",
                     new { @class = "form-control", id = "dtpFechaNacimiento", placeholder = "dd/mm/aaaa" })
            @Html.ValidationMessageFor(m => m.FechaNacimiento, "", new { @class = "text-danger small" })
        </div>
        <div class="col-md-2">
            <label class="form-label">Sexo <span class="req">*</span></label>
            @Html.DropDownListFor(m => m.SexoID,
                     new SelectList(Enumerable.Empty<SelectListItem>(), "Value", "Text"),
                     "-- Seleccione --",
                     new { @class = "form-select", id = "ddlSexo" })
            @Html.ValidationMessageFor(m => m.SexoID, "", new { @class = "text-danger small" })
        </div>
        <div class="col-md-3">
            <label class="form-label">Nacionalidad <span class="req">*</span></label>
            @Html.DropDownListFor(m => m.NacionalidadID,
                     new SelectList(Enumerable.Empty<SelectListItem>(), "Value", "Text"),
                     "-- Seleccione --",
                     new { @class = "form-select", id = "ddlNacionalidad" })
            @Html.ValidationMessageFor(m => m.NacionalidadID, "", new { @class = "text-danger small" })
        </div>
        <div class="col-md-3">
            <label class="form-label">Estado del Alumno <span class="req">*</span></label>
            @Html.DropDownListFor(m => m.EstadoAlumnoID,
                     new SelectList(Enumerable.Empty<SelectListItem>(), "Value", "Text"),
                     "-- Seleccione --",
                     new { @class = "form-select", id = "ddlEstadoAlumno" })
            <div class="invalid-feedback">El estado del alumno es obligatorio.</div>
        </div>

    </div>
</div>

@* ══════════════════════════════════════════════════════════════════════
   SECCIÓN 2 — DOMICILIO Y CONTACTO
   ══════════════════════════════════════════════════════════════════════ *@
<div class="form-section sec-contacto">
    <p class="sec-title"><i class="bi bi-geo-alt-fill"></i> Domicilio y contacto</p>
    <div class="row g-3">

        <div class="col-md-5">
            <label class="form-label">Dirección</label>
            @Html.TextBoxFor(m => m.Direccion, new { @class = "form-control", placeholder = "Calle / número / villa" })
        </div>
        <div class="col-md-3">
            <label class="form-label">Región</label>
            <select id="ddlRegion" class="form-select">
                <option value="">-- Seleccione --</option>
            </select>
        </div>
        <div class="col-md-4">
            <label class="form-label">Comuna</label>
            @Html.DropDownListFor(m => m.ComunaID,
                     new SelectList(Enumerable.Empty<SelectListItem>(), "Value", "Text"),
                     "-- Seleccione --",
                     new { @class = "form-select", id = "ddlComuna" })
        </div>
        <div class="col-md-3">
            <label class="form-label">Teléfono</label>
            @Html.TextBoxFor(m => m.Telefono, new { @class = "form-control", placeholder = "+56 9 XXXX XXXX" })
        </div>
        <div class="col-md-5">
            <label class="form-label">Correo electrónico</label>
            @Html.TextBoxFor(m => m.Email, new { @class = "form-control", type = "email", placeholder = "correo@dominio.cl" })
            @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger small" })
        </div>

    </div>
</div>

@* ══════════════════════════════════════════════════════════════════════
   SECCIÓN 3 — SALUD
   ══════════════════════════════════════════════════════════════════════ *@
<div class="form-section sec-salud">
    <p class="sec-title"><i class="bi bi-heart-pulse-fill"></i> Salud</p>
    <div class="row g-3">

        <div class="col-md-3">
            <label class="form-label">Sistema de Salud</label>
            @Html.DropDownListFor(m => m.SistemaSaludID,
                     new SelectList(Enumerable.Empty<SelectListItem>(), "Value", "Text"),
                     "-- Seleccione --",
                     new { @class = "form-select", id = "ddlSistemaSalud" })
        </div>


        <div class="col-md-3 d-flex align-items-center">
            <div class="form-check mt-3">
                @Html.CheckBoxFor(m => m.TienePIE, new { @class = "form-check-input", id = "chkTienePIE" })
                <label class="form-check-label fw-semibold" for="chkTienePIE">
                    <i class="bi bi-universal-access me-1 text-info"></i>Programa de Integración (PIE)
                </label>
                <div class="text-muted small">El alumno es parte del programa PIE</div>
            </div>
        </div>

        <div class="col-12">
            <div class="d-flex align-items-center justify-content-between mb-2">
                <span class="fw-semibold small text-secondary">
                    <i class="bi bi-universal-access me-1"></i>Discapacidades
                    <span class="text-muted fw-normal ms-1">(certificado médico obligatorio por cada una)</span>
                </span>
                <button type="button" class="btn btn-outline-warning btn-sm" id="btnAgregarFilaDiscapacidad">
                    <i class="bi bi-plus-circle me-1"></i>Agregar
                </button>
            </div>

            @if (Model.ID > 0 && Model.Discapacidades.Any())
            {
                <table class="table table-sm table-bordered align-middle mb-2">
                    <thead class="table-light">
                        <tr>
                            <th style="width:200px">Tipo</th>
                            <th>Descripción</th>
                            <th style="width:120px" class="text-center">Certificado</th>
                            <th style="width:44px"></th>
                        </tr>
                    </thead>
                    <tbody id="tbodyDiscapacidadesGuardadas">
                        @foreach (var d in Model.Discapacidades)
                        {
                            <tr data-id="@d.ID">
                                <td><span class="badge bg-warning text-dark">@d.TipoDiscapacidad</span></td>
                                <td>@(d.Descripcion ?? "—")</td>
                                <td class="text-center">
                                    @if (d.TieneCertificado)
                                    {
                                        <a href="@Url.Action("DescargarCertificadoDiscapacidad","Alumnos",new{id=d.ID})"
                                           class="btn btn-outline-secondary btn-sm" target="_blank">
                                            <i class="bi bi-file-earmark-arrow-down"></i>
                                        </a>
                                    }
                                    else { <span class="badge bg-danger">Sin cert.</span> }
                                </td>
                                <td class="text-center">
                                    <button type="button" class="btn btn-outline-danger btn-sm btn-eliminar-discapacidad"
                                            data-id="@d.ID"><i class="bi bi-trash"></i></button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }

            <div id="containerDiscapacidadesNuevas">
                <table class="table table-sm table-bordered align-middle d-none" id="tblDiscapacidadesNuevas">
                    <thead class="table-light">
                        <tr>
                            <th style="width:200px">Tipo <span class="req">*</span></th>
                            <th>Descripción</th>
                            <th style="width:260px">Certificado médico <span class="req">*</span></th>
                            <th style="width:40px"></th>
                        </tr>
                    </thead>
                    <tbody id="tbodyDiscapacidadesNuevas"></tbody>
                </table>
            </div>
        </div>

        <div class="col-12">
            <div class="d-flex align-items-center justify-content-between mb-2">
                <span class="fw-semibold small text-secondary">
                    <i class="bi bi-capsule me-1"></i>Alergias
                </span>
                <button type="button" class="btn btn-outline-primary btn-sm" id="btnAgregarFilaAlergia">
                    <i class="bi bi-plus-circle me-1"></i>Agregar
                </button>
            </div>

            @if (Model.ID > 0 && Model.Alergias.Any())
            {
                <table class="table table-sm table-bordered align-middle mb-2">
                    <thead class="table-light">
                        <tr>
                            <th style="width:130px">Tipo</th>
                            <th>Alergia</th>
                            <th>Detalle</th>
                            <th style="width:110px" class="text-center">Certificado</th>
                            <th style="width:44px"></th>
                        </tr>
                    </thead>
                    <tbody id="tbodyAlergiasGuardadas">
                        @foreach (var a in Model.Alergias)
                        {
                            <tr data-id="@a.ID">
                                <td>
                                    @if (a.TipoAlergiaID == 1)
                                    { <span class="badge bg-primary">Informativa</span> }
                                    else
                                    { <span class="badge bg-warning text-dark">Alimenticia</span> }
                                </td>
                                <td>@a.NombreAlergia</td>
                                <td>@(a.Descripcion ?? "—")</td>
                                <td class="text-center">
                                    @if (a.TieneCertificado)
                                    {
                                        <a href="@Url.Action("DescargarCertificadoAlergia","Alumnos",new{id=a.ID})"
                                           class="btn btn-outline-secondary btn-sm" target="_blank">
                                            <i class="bi bi-file-earmark-arrow-down"></i>
                                        </a>
                                    }
                                    else { <span class="text-muted small">—</span> }
                                </td>
                                <td class="text-center">
                                    <button type="button" class="btn btn-outline-danger btn-sm btn-eliminar-alergia"
                                            data-id="@a.ID"><i class="bi bi-trash"></i></button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }

            <div id="containerAlergiasNuevas">
                <table class="table table-sm table-bordered align-middle d-none" id="tblAlergiasNuevas">
                    <thead class="table-light">
                        <tr>
                            <th style="width:150px">Tipo <span class="req">*</span></th>
                            <th>Alergia <span class="req">*</span></th>
                            <th style="width:200px">Detalle</th>
                            <th style="width:220px">Certificado</th>
                            <th style="width:40px"></th>
                        </tr>
                    </thead>
                    <tbody id="tbodyAlergiasNuevas"></tbody>
                </table>
            </div>
        </div>

    </div>
</div>

@* ══════════════════════════════════════════════════════════════════════
   SECCIÓN 4 — DATOS SOCIOECONÓMICOS Y CULTURALES
   ══════════════════════════════════════════════════════════════════════ *@
<div class="form-section sec-social">
    <p class="sec-title"><i class="bi bi-people-fill"></i> Datos socioeconómicos y culturales</p>
    <div class="row g-3">

        <div class="col-md-3">
            <label class="form-label">Etnia</label>
            @Html.DropDownListFor(m => m.EtniaID,
                     new SelectList(Enumerable.Empty<SelectListItem>(), "Value", "Text"),
                     "-- Seleccione --",
                     new { @class = "form-select", id = "ddlEtnia" })
        </div>
        <div class="col-md-4">
            <label class="form-label">Condición Socioeconómica</label>
            @Html.DropDownListFor(m => m.CondicionSocioeconomicaID,
                     new SelectList(Enumerable.Empty<SelectListItem>(), "Value", "Text"),
                     "-- Seleccione --",
                     new { @class = "form-select", id = "ddlCondicionSocioeconomica" })
        </div>
        <div class="col-md-3">
            <label class="form-label">Vive con</label>
            @Html.DropDownListFor(m => m.ViveConID,
                     new SelectList(Enumerable.Empty<SelectListItem>(), "Value", "Text"),
                     "-- Seleccione --",
                     new { @class = "form-select", id = "ddlViveCon" })
        </div>

    </div>
</div>

@* ══════════════════════════════════════════════════════════════════════
   SECCIÓN 5 — APODERADOS
   ══════════════════════════════════════════════════════════════════════ *@
<div class="form-section" style="border-left-color:#6f42c1">
    <p class="sec-title"><i class="bi bi-people-fill"></i> Apoderados</p>

    @* ── Padre ── *@
    <div class="mb-3">
        <div class="d-flex align-items-center gap-2 mb-2">
            <span class="badge bg-primary">Padre</span>
            <span class="text-muted small">Complete los datos del padre del alumno</span>
        </div>
        @Html.HiddenFor(m => m.ApoderadoPadre.ApoderadoID)
        <div class="row g-2 mb-2">
            <div class="col-md-2">
                <label class="form-label form-label-sm">RUT</label>
                @Html.TextBoxFor(m => m.ApoderadoPadre.Rut, new { @class = "form-control form-control-sm", placeholder = "12.345.678-9", id = "txtRutPadre", autocomplete = "off" })
                <div id="feedbackRutPadre" class="small mt-1"></div>
            </div>
            <div class="col-md-3">
                <label class="form-label form-label-sm">Apellido Paterno</label>
                @Html.TextBoxFor(m => m.ApoderadoPadre.ApellidoPaterno, new { @class = "form-control form-control-sm" })
            </div>
            <div class="col-md-3">
                <label class="form-label form-label-sm">Apellido Materno</label>
                @Html.TextBoxFor(m => m.ApoderadoPadre.ApellidoMaterno, new { @class = "form-control form-control-sm" })
            </div>
            <div class="col-md-4">
                <label class="form-label form-label-sm">Nombres</label>
                @Html.TextBoxFor(m => m.ApoderadoPadre.Nombres, new { @class = "form-control form-control-sm" })
            </div>
            <div class="col-md-3">
                <label class="form-label form-label-sm">Nacionalidad</label>
                @Html.DropDownListFor(m => m.ApoderadoPadre.NacionalidadID,
                    new SelectList(Enumerable.Empty<SelectListItem>(), "Value", "Text"),
                    "-- Seleccione --",
                    new { @class = "form-select form-select-sm", id = "ddlNacionalidadPadre" })
            </div>
        </div>
        <div class="row g-2 mb-2">
            <div class="col-md-4">
                <label class="form-label form-label-sm">Nivel Educacional</label>
                @Html.DropDownListFor(m => m.ApoderadoPadre.NivelEducacionalID,
                    new SelectList(Enumerable.Empty<SelectListItem>(), "Value", "Text"),
                    "-- Seleccione --",
                    new { @class = "form-select form-select-sm", id = "ddlNivelEducPadre" })
            </div>
            <div class="col-md-4">
                <label class="form-label form-label-sm">Situación Laboral</label>
                @Html.DropDownListFor(m => m.ApoderadoPadre.SituacionLaboralID,
                    new SelectList(Enumerable.Empty<SelectListItem>(), "Value", "Text"),
                    "-- Seleccione --",
                    new { @class = "form-select form-select-sm", id = "ddlSitLaboralPadre" })
            </div>
            <div class="col-md-4">
                <label class="form-label form-label-sm">Lugar de Trabajo</label>
                @Html.TextBoxFor(m => m.ApoderadoPadre.LugarTrabajo, new { @class = "form-control form-control-sm", placeholder = "Empresa / Institución" })
            </div>
        </div>
        <div class="row g-2">
            <div class="col-md-5">
                <label class="form-label form-label-sm">Dirección</label>
                @Html.TextBoxFor(m => m.ApoderadoPadre.Direccion, new { @class = "form-control form-control-sm", placeholder = "Calle / número / villa" })
            </div>
            <div class="col-md-3">
                <label class="form-label form-label-sm">Región</label>
                <select id="ddlRegionPadre" class="form-select form-select-sm"><option value="">-- Seleccione --</option></select>
                @Html.HiddenFor(m => m.ApoderadoPadre.RegionID, new { id = "hdnRegionPadre" })
            </div>
            <div class="col-md-4">
                <label class="form-label form-label-sm">Comuna</label>
                @Html.DropDownListFor(m => m.ApoderadoPadre.ComunaID,
                    new SelectList(Enumerable.Empty<SelectListItem>(), "Value", "Text"),
                    "-- Seleccione --",
                    new { @class = "form-select form-select-sm", id = "ddlComunaPadre" })
            </div>
            <div class="col-md-3">
                <label class="form-label form-label-sm">Teléfono Fijo</label>
                @Html.TextBoxFor(m => m.ApoderadoPadre.Telefono, new { @class = "form-control form-control-sm", placeholder = "+56 2 XXXX XXXX" })
            </div>
            <div class="col-md-3">
                <label class="form-label form-label-sm">Celular</label>
                @Html.TextBoxFor(m => m.ApoderadoPadre.TelefonoCelular, new { @class = "form-control form-control-sm", placeholder = "+56 9 XXXX XXXX" })
            </div>
            <div class="col-md-4">
                <label class="form-label form-label-sm">Correo</label>
                @Html.TextBoxFor(m => m.ApoderadoPadre.Email, new { @class = "form-control form-control-sm", type = "email" })
            </div>
            <div class="col-md-2 d-flex align-items-end pb-1">
                <div class="form-check">
                    @Html.CheckBoxFor(m => m.ApoderadoPadre.EsApoderadoTitular, new { @class = "form-check-input" })
                    <label class="form-check-label small fw-semibold text-primary">Titular</label>
                </div>
            </div>
            @Html.HiddenFor(m => m.ApoderadoPadre.ParentescoID, new { id = "hdnParentescoPadre" })
        </div>
    </div>

    <hr class="my-3" />

    @* ── Madre ── *@
    <div>
        <div class="d-flex align-items-center gap-2 mb-2">
            <span class="badge bg-success">Madre</span>
            <span class="text-muted small">Complete los datos de la madre del alumno</span>
        </div>
        @Html.HiddenFor(m => m.ApoderadoMadre.ApoderadoID)
        <div class="row g-2 mb-2">
            <div class="col-md-2">
                <label class="form-label form-label-sm">RUT</label>
                @Html.TextBoxFor(m => m.ApoderadoMadre.Rut, new { @class = "form-control form-control-sm", placeholder = "12.345.678-9", id = "txtRutMadre", autocomplete = "off" })
                <div id="feedbackRutMadre" class="small mt-1"></div>
            </div>
            <div class="col-md-3">
                <label class="form-label form-label-sm">Apellido Paterno</label>
                @Html.TextBoxFor(m => m.ApoderadoMadre.ApellidoPaterno, new { @class = "form-control form-control-sm" })
            </div>
            <div class="col-md-3">
                <label class="form-label form-label-sm">Apellido Materno</label>
                @Html.TextBoxFor(m => m.ApoderadoMadre.ApellidoMaterno, new { @class = "form-control form-control-sm" })
            </div>
            <div class="col-md-4">
                <label class="form-label form-label-sm">Nombres</label>
                @Html.TextBoxFor(m => m.ApoderadoMadre.Nombres, new { @class = "form-control form-control-sm" })
            </div>
            <div class="col-md-3">
                <label class="form-label form-label-sm">Nacionalidad</label>
                @Html.DropDownListFor(m => m.ApoderadoMadre.NacionalidadID,
                    new SelectList(Enumerable.Empty<SelectListItem>(), "Value", "Text"),
                    "-- Seleccione --",
                    new { @class = "form-select form-select-sm", id = "ddlNacionalidadMadre" })
            </div>
        </div>
        <div class="row g-2 mb-2">
            <div class="col-md-4">
                <label class="form-label form-label-sm">Nivel Educacional</label>
                @Html.DropDownListFor(m => m.ApoderadoMadre.NivelEducacionalID,
                    new SelectList(Enumerable.Empty<SelectListItem>(), "Value", "Text"),
                    "-- Seleccione --",
                    new { @class = "form-select form-select-sm", id = "ddlNivelEducMadre" })
            </div>
            <div class="col-md-4">
                <label class="form-label form-label-sm">Situación Laboral</label>
                @Html.DropDownListFor(m => m.ApoderadoMadre.SituacionLaboralID,
                    new SelectList(Enumerable.Empty<SelectListItem>(), "Value", "Text"),
                    "-- Seleccione --",
                    new { @class = "form-select form-select-sm", id = "ddlSitLaboralMadre" })
            </div>
            <div class="col-md-4">
                <label class="form-label form-label-sm">Lugar de Trabajo</label>
                @Html.TextBoxFor(m => m.ApoderadoMadre.LugarTrabajo, new { @class = "form-control form-control-sm", placeholder = "Empresa / Institución" })
            </div>
        </div>
        <div class="row g-2">
            <div class="col-md-5">
                <label class="form-label form-label-sm">Dirección</label>
                @Html.TextBoxFor(m => m.ApoderadoMadre.Direccion, new { @class = "form-control form-control-sm", placeholder = "Calle / número / villa" })
            </div>
            <div class="col-md-3">
                <label class="form-label form-label-sm">Región</label>
                <select id="ddlRegionMadre" class="form-select form-select-sm"><option value="">-- Seleccione --</option></select>
                @Html.HiddenFor(m => m.ApoderadoMadre.RegionID, new { id = "hdnRegionMadre" })
            </div>
            <div class="col-md-4">
                <label class="form-label form-label-sm">Comuna</label>
                @Html.DropDownListFor(m => m.ApoderadoMadre.ComunaID,
                    new SelectList(Enumerable.Empty<SelectListItem>(), "Value", "Text"),
                    "-- Seleccione --",
                    new { @class = "form-select form-select-sm", id = "ddlComunaMadre" })
            </div>
            <div class="col-md-3">
                <label class="form-label form-label-sm">Teléfono Fijo</label>
                @Html.TextBoxFor(m => m.ApoderadoMadre.Telefono, new { @class = "form-control form-control-sm", placeholder = "+56 2 XXXX XXXX" })
            </div>
            <div class="col-md-3">
                <label class="form-label form-label-sm">Celular</label>
                @Html.TextBoxFor(m => m.ApoderadoMadre.TelefonoCelular, new { @class = "form-control form-control-sm", placeholder = "+56 9 XXXX XXXX" })
            </div>
            <div class="col-md-4">
                <label class="form-label form-label-sm">Correo</label>
                @Html.TextBoxFor(m => m.ApoderadoMadre.Email, new { @class = "form-control form-control-sm", type = "email" })
            </div>
            <div class="col-md-2 d-flex align-items-end pb-1">
                <div class="form-check">
                    @Html.CheckBoxFor(m => m.ApoderadoMadre.EsApoderadoTitular, new { @class = "form-check-input" })
                    <label class="form-check-label small fw-semibold text-primary">Titular</label>
                </div>
            </div>
            @Html.HiddenFor(m => m.ApoderadoMadre.ParentescoID, new { id = "hdnParentescoMadre" })
        </div>
    </div>
</div>

