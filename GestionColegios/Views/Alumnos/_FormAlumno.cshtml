<script>
    $(document).ready(function () {

        // ── Validación de campos obligatorios ─────────────────────────
        // Retorna true si todo es válido; false y marca los campos si no.
        window.validarFormulario = function () {
            var valido = true;

            // Definición de reglas: [selector, mensaje de error exacto]
            var reglas = [
                { sel: '#txtRut',            msg: 'El RUT es obligatorio.',                  tipo: 'texto'    },
                { sel: '#Nombres',           msg: 'Los nombres son obligatorios.',             tipo: 'texto'    },
                { sel: '#ApellidoPaterno',   msg: 'El apellido paterno es obligatorio.',       tipo: 'texto'    },
                { sel: '#dtpFechaNacimiento',msg: 'La fecha de nacimiento es obligatoria.',   tipo: 'texto'    },
                { sel: '#ddlSexo',           msg: 'El sexo es obligatorio.',                  tipo: 'select'   },
                { sel: '#ddlNacionalidad',   msg: 'La nacionalidad es obligatoria.',          tipo: 'select'   },
                { sel: '#ddlEstadoAlumno',   msg: 'El estado del alumno es obligatorio.',     tipo: 'select'   }
            ];

            // Limpiar estado previo
            $.each(reglas, function (i, r) {
                $(r.sel).removeClass('is-invalid').siblings('.field-error-msg').remove();
            });
            // Limpiar error RUT duplicado si ya es válido
            if ($('#rutFeedback').hasClass('text-success')) { /* ok */ }

            $.each(reglas, function (i, r) {
                var $el = $(r.sel);
                var val = $.trim($el.val());
                var vacio = (r.tipo === 'select') ? (val === '' || val === '0') : (val === '');
                if (vacio) {
                    $el.addClass('is-invalid');
                    $el.after('<div class="field-error-msg text-danger small mt-1">' + r.msg + '</div>');
                    valido = false;
                }
            });

            // Validar RUT (usa la función ya definida más abajo)
            var rutVal = $.trim($('#txtRut').val());
            if (rutVal && !validarRutFormato(rutVal)) {
                $('#txtRut').addClass('is-invalid');
                $('#rutFeedback').removeClass('text-success text-warning')
                    .addClass('text-danger').text('✖ El RUT ingresado no es válido.');
                valido = false;
            } else if ($('#rutFeedback').hasClass('text-danger')) {
                valido = false;
            }

            if (!valido) {
                // Hacer scroll al primer campo inválido
                var $primero = $('.is-invalid, #rutFeedback.text-danger').first();
                if ($primero.length) {
                    $('html, body').animate({ scrollTop: $primero.offset().top - 100 }, 300);
                }
            }

            return valido;
        };

        // Limpiar marca de error al corregir
        $(document).on('input change', '.is-invalid', function () {
            $(this).removeClass('is-invalid').siblings('.field-error-msg').remove();
        });

        // ── DatePicker ────────────────────────────────────────────────
        $("#dtpFechaNacimiento").kendoDatePicker({
            format: "dd/MM/yyyy",
            max: new Date()
        });

        // ── Cargar Sexo ───────────────────────────────────────────────
        $.getJSON("@Url.Action("Sexos", "Lookup")", function (data) {
            var ddl = $("#ddlSexo");
            $.each(data, function (i, item) {
                ddl.append($("<option>").val(item.ID).text(item.Texto));
            });
            ddl.val("@Model.SexoID");
        });

        // ── Validación RUT chileno ────────────────────────────────────
        var alumnoIdActual = @Model.ID;  // 0 en crear, >0 en editar

        function formatearRut(rut) {
            rut = rut.replace(/[^0-9kK]/g, '').toUpperCase();
            if (rut.length < 2) return rut;
            var cuerpo = rut.slice(0, -1);
            var dv = rut.slice(-1);
            cuerpo = cuerpo.replace(/\B(?=(\d{3})+(?!\d))/g, '.');
            return cuerpo + '-' + dv;
        }

        function calcularDv(rut) {
            var suma = 0, multiplo = 2;
            for (var i = rut.length - 1; i >= 0; i--) {
                suma += parseInt(rut.charAt(i)) * multiplo;
                multiplo = multiplo < 7 ? multiplo + 1 : 2;
            }
            var res = 11 - (suma % 11);
            if (res === 11) return '0';
            if (res === 10) return 'K';
            return String(res);
        }

        function validarRutFormato(rut) {
            rut = rut.replace(/[.\-]/g, '').toUpperCase();
            if (!/^\d{7,8}[0-9K]$/.test(rut)) return false;
            var cuerpo = rut.slice(0, -1);
            var dv = rut.slice(-1);
            return calcularDv(cuerpo) === dv;
        }

        function mostrarFeedbackRut(msg, tipo) {
            // tipo: 'ok' | 'error' | 'info' | ''
            var colores = { ok: 'text-success', error: 'text-danger', info: 'text-warning', '': '' };
            var iconos  = { ok: '✔', error: '✖', info: '⚠', '': '' };
            var $fb = $('#rutFeedback');
            $fb.removeClass('text-success text-danger text-warning')
               .addClass(colores[tipo] || '')
               .text(msg ? (iconos[tipo] + ' ' + msg) : '');
        }

        var rutTimer;
        $('#txtRut').on('input', function () {
            var raw = $(this).val().replace(/[^0-9kK]/g, '').toUpperCase();
            if (raw.length > 1) $(this).val(formatearRut(raw));

            clearTimeout(rutTimer);
            var rut = $(this).val();
            if (!rut) { mostrarFeedbackRut('', ''); return; }

            if (!validarRutFormato(rut)) {
                mostrarFeedbackRut('RUT inválido.', 'error');
                return;
            }

            mostrarFeedbackRut('Verificando…', 'info');
            rutTimer = setTimeout(function () {
                $.getJSON('@Url.Action("ValidarRut", "Alumnos")',
                    { rut: rut, alumnoId: alumnoIdActual },
                    function (r) {
                        if (r.duplicado) {
                            mostrarFeedbackRut('Este RUT ya está registrado.', 'error');
                        } else {
                            mostrarFeedbackRut('RUT válido y disponible.', 'ok');
                        }
                    });
            }, 500);
        });

        // Bloquear envío si RUT es inválido
        $(document).on('submit-validar-rut', function () {
            var rut = $('#txtRut').val();
            if (!validarRutFormato(rut)) {
                mostrarFeedbackRut('Corrija el RUT antes de continuar.', 'error');
                return false;
            }
            return true;
        });

        // ── Cargar Nacionalidades ─────────────────────────────────────
        $.getJSON("@Url.Action("Nacionalidades", "Lookup")", function (data) {
            var ddl = $("#ddlNacionalidad");
            $.each(data, function (i, item) {
                ddl.append($("<option>").val(item.ID).text(item.Texto));
            });
            ddl.val("@Model.NacionalidadID");
        });

        // ── Cargar Sistema de Salud ───────────────────────────────────
        $.getJSON("@Url.Action("SistemasSalud", "Lookup")", function (data) {
            var ddl = $("#ddlSistemaSalud");
            $.each(data, function (i, item) {
                ddl.append($("<option>").val(item.ID).text(item.Texto));
            });
            ddl.val("@Model.SistemaSaludID");
        });

        // ── Cargar Etnias ──────────────────────────────────────────────
        $.getJSON("@Url.Action("Etnias", "Lookup")", function (data) {
            var ddl = $("#ddlEtnia");
            $.each(data, function (i, item) {
                ddl.append($("<option>").val(item.ID).text(item.Texto));
            });
            ddl.val("@Model.EtniaID");
        });

        // ── Cargar Condiciones Socioeconómicas ─────────────────────────
        $.getJSON("@Url.Action("CondicionesSocioeconomicas", "Lookup")", function (data) {
            var ddl = $("#ddlCondicionSocioeconomica");
            $.each(data, function (i, item) {
                ddl.append($("<option>").val(item.ID).text(item.Texto));
            });
            ddl.val("@Model.CondicionSocioeconomicaID");
        });

        // ── Cargar Vive Con ────────────────────────────────────────────
        $.getJSON("@Url.Action("ViveCon", "Lookup")", function (data) {
            var ddl = $("#ddlViveCon");
            $.each(data, function (i, item) {
                ddl.append($("<option>").val(item.ID).text(item.Texto));
            });
            ddl.val("@Model.ViveConID");
        });

        // ── Cargar Estado Alumno ──────────────────────────────────────
        $.getJSON("@Url.Action("EstadosAlumno", "Lookup")", function (data) {
            var ddl = $("#ddlEstadoAlumno");
            $.each(data, function (i, item) {
                ddl.append($("<option>").val(item.ID).text(item.Texto));
            });
            ddl.val("@Model.EstadoAlumnoID");
        });

        // ── Cargar Regiones y Comunas en cascada ─────────────────────
        var regionIdActual = @Html.Raw(Model.RegionID.HasValue ? Model.RegionID.Value.ToString() : "null");
        var comunaIdActual = @Html.Raw(Model.ComunaID.HasValue  ? Model.ComunaID.Value.ToString()  : "null");

        $.getJSON("@Url.Action("Regiones", "Lookup")", function (data) {
            var ddl = $("#ddlRegion");
            $.each(data, function (i, item) {
                ddl.append($("<option>").val(item.ID).text(item.Texto));
            });
            if (regionIdActual !== null) {
                ddl.val(regionIdActual);
                cargarComunas(regionIdActual, comunaIdActual);
            }
        });

        $("#ddlRegion").change(function () {
            cargarComunas(parseInt($(this).val()) || null, null);
        });

        function cargarComunas(regionId, comunaId) {
            if (!regionId) return;
            $.getJSON("@Url.Action("ComunasPorRegion", "Lookup")", { regionId: regionId }, function (data) {
                var ddl = $("#ddlComuna");
                ddl.empty().append('<option value="">-- Seleccione --</option>');
                $.each(data, function (i, item) {
                    ddl.append($("<option>").val(item.ID).text(item.Texto));
                });
                if (comunaId !== null) ddl.val(comunaId);
            });
        }

        // ── Alergias ──────────────────────────────────────────────────
        var tiposAlergia = [];       // [{ID, Texto}]
        var catalogoCache = {};      // {tipoId: [{ID, Texto, RequiereDetalle}]}
        var filaIdx = 0;

        // Cargar tipos desde BD
        $.getJSON("@Url.Action("TiposAlergia", "Lookup")", function (data) {
            tiposAlergia = data;
        });

        // Cargar catálogo por tipo (con caché)
        function cargarCatalogo(tipoId, cb) {
            if (catalogoCache[tipoId]) { cb(catalogoCache[tipoId]); return; }
            $.getJSON("@Url.Action("CatalogoAlergias", "Lookup")", { tipoAlergiaId: tipoId }, function (data) {
                catalogoCache[tipoId] = data;
                cb(data);
            });
        }

        // Agregar fila nueva a la tabla
        $("#btnAgregarFilaAlergia").click(function () {
            var idx = filaIdx++;
            var tmpl = document.getElementById("templateFilaAlergia").innerHTML
                .replace(/__IDX__/g, idx);

            var $fila = $(tmpl);
            var $selTipo = $fila.find(".sel-tipo-alergia");

            // Poblar tipos desde BD
            $.each(tiposAlergia, function (i, t) {
                $selTipo.append($("<option>").val(t.ID).text(t.Texto));
            });
            // Si aun no se cargaron, recargar y poblar
            if (tiposAlergia.length === 0) {
                $.getJSON("@Url.Action("TiposAlergia", "Lookup")", function (data) {
                    tiposAlergia = data;
                    $.each(data, function (i, t) {
                        $selTipo.append($("<option>").val(t.ID).text(t.Texto));
                    });
                });
            }

            // Evento cambio de tipo
            $selTipo.change(function () {
                var tipoId = parseInt($(this).val());
                var $tdNombre = $fila.find(".td-nombre");
                var $tdDesc = $fila.find(".td-descripcion");
                var $inpDesc = $fila.find(".inp-descripcion");
                var $tdCert = $fila.find(".td-certificado");
                var $wrapCert = $fila.find(".inp-certificado-wrap");

                $tdNombre.empty();
                $inpDesc.hide().val("");
                $wrapCert.hide();
                $fila.find(".inp-certificado").val("");

                if (!tipoId) return;

                if (tipoId === 1) {
                    // Informativa: nombre libre + certificado obligatorio
                    $tdNombre.append(
                        $('<input type="text" class="form-control form-control-sm inp-nombre-libre" placeholder="Ej: Alergia al polvo de ácaros" required />')
                            .attr("name", "AlergiasPendientes[" + idx + "].NombreAlergia")
                    );
                    $wrapCert.show();
                } else {
                    // Alimenticia: catálogo desde BD
                    var $sel = $('<select class="form-select form-select-sm sel-catalogo" required></select>')
                        .attr("name", "AlergiasPendientes[" + idx + "].NombreAlergia");
                    $sel.append('<option value="">-- Seleccione --</option>');

                    cargarCatalogo(tipoId, function (items) {
                        $.each(items, function (i, item) {
                            $sel.append($("<option>").val(item.Texto).text(item.Texto)
                                .data("requiere-detalle", item.RequiereDetalle));
                        });
                    });

                    $sel.change(function () {
                        var opt = $(this).find(":selected");
                        var req = opt.data("requiere-detalle");
                        if (req) { $inpDesc.show(); }
                        else { $inpDesc.hide().val(""); }
                    });

                    $tdNombre.append($sel);
                }
            });

            // Botón quitar fila
            $fila.find(".btn-quitar-fila").click(function () {
                $fila.remove();
                reindexarFilas();
                if ($("#tbodyAlergiasNuevas tr").length === 0)
                    $("#tblAlergiasNuevas").addClass("d-none");
            });

            $("#tbodyAlergiasNuevas").append($fila);
            $("#tblAlergiasNuevas").removeClass("d-none");
        });

        // Reindexar names tras eliminar filas intermedias
        function reindexarFilas() {
            $("#tbodyAlergiasNuevas tr.fila-alergia-nueva").each(function (newIdx) {
                $(this).find("[name]").each(function () {
                    var n = $(this).attr("name");
                    $(this).attr("name", n.replace(/AlergiasPendientes\[\d+\]/, "AlergiasPendientes[" + newIdx + "]"));
                });
            });
            filaIdx = $("#tbodyAlergiasNuevas tr").length;
        }

        // Eliminar alergia ya guardada (modo edición) vía AJAX
        $(document).on("click", ".btn-eliminar-alergia", function () {
            var id    = $(this).data("id");
            var $fila = $(this).closest("tr");
            showConfirm({
                tipo: 'danger',
                titulo: 'Eliminar alergia',
                mensaje: 'Se eliminará esta alergia del registro del alumno.',
                onOk: function () {
                    $.post("@Url.Action("EliminarAlergia", "Alumnos")",
                        { alergiaId: id, __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val() },
                        function (r) {
                            if (r.success) $fila.fadeOut(200, function () { $(this).remove(); });
                            else showAlert({ tipo: 'danger', titulo: 'Error', mensaje: 'No se pudo eliminar la alergia.' });
                        });
                }
            });
        });

        // ════════════════════════════════════════════════════════════
        // DISCAPACIDADES
        // ════════════════════════════════════════════════════════════
        var discapacidadIdx = 0;
        var tiposDiscapacidad = [];

        $.getJSON("@Url.Action("TiposDiscapacidad", "Lookup")", function (data) {
            tiposDiscapacidad = data;
        });

        function agregarFilaDiscapacidad() {
            var tpl = document.getElementById("templateFilaDiscapacidad").innerHTML
                .replace(/__IDX__/g, discapacidadIdx++);
            var $fila = $(tpl);
            var $sel = $fila.find(".sel-tipo-discapacidad");
            $.each(tiposDiscapacidad, function (i, t) {
                $sel.append($("<option>").val(t.ID).text(t.Texto));
            });
            $("#tbodyDiscapacidadesNuevas").append($fila);
            $("#tblDiscapacidadesNuevas").removeClass("d-none");
        }

        $("#btnAgregarFilaDiscapacidad").click(agregarFilaDiscapacidad);

        $(document).on("click", ".btn-quitar-fila-disc", function () {
            $(this).closest("tr").remove();
            if ($("#tbodyDiscapacidadesNuevas tr").length === 0)
                $("#tblDiscapacidadesNuevas").addClass("d-none");
        });

        $(document).on("click", ".btn-eliminar-discapacidad", function () {
            var id = $(this).data("id");
            showConfirm({
                tipo: 'danger',
                titulo: 'Eliminar discapacidad',
                mensaje: 'Se eliminará esta discapacidad y su certificado del registro del alumno.',
                onOk: function () {
                    $.post("@Url.Action("EliminarDiscapacidad", "Alumnos")", { discapacidadId: id })
                        .done(function (r) {
                            if (r.success) $("tr[data-id='" + id + "']").fadeOut(200, function () { $(this).remove(); });
                            else showAlert({ tipo: 'danger', titulo: 'Error', mensaje: 'No se pudo eliminar la discapacidad.' });
                        });
                }
            });
        });

        // ════════════════════════════════════════════════════════════
        // APODERADOS INLINE
        // ════════════════════════════════════════════════════════════

        // Cargar IDs de parentesco Padre/Madre y asignarlos a los hiddens
        $.getJSON("@Url.Action("Parentescos","Lookup")", function (data) {
            $.each(data, function (i, d) {
                var n = d.Texto.toLowerCase();
                if (n === 'padre')  $('#hdnParentescoPadre').val(d.ID);
                if (n === 'madre')  $('#hdnParentescoMadre').val(d.ID);
            });
        });

        // Helper: cargar un dropdown con datos
        function cargarDdlApo(url, $ddl, valorActual) {
            $.getJSON(url, function (data) {
                $.each(data, function (i, d) { $ddl.append($('<option>').val(d.ID).text(d.Texto)); });
                if (valorActual) $ddl.val(valorActual);
            });
        }

        // Helper: cargar comunas de una región
        function cargarComunasApo(regionId, comunaId, $ddlComuna) {
            if (!regionId) return;
            $.getJSON("@Url.Action("ComunasPorRegion","Lookup")", { regionId: regionId }, function (data) {
                $ddlComuna.empty().append('<option value="">-- Seleccione --</option>');
                $.each(data, function (i, d) { $ddlComuna.append($('<option>').val(d.ID).text(d.Texto)); });
                if (comunaId) $ddlComuna.val(comunaId);
            });
        }

        // Cargar catálogos comunes una sola vez
        var urlNac    = "@Url.Action("Nacionalidades","Lookup")";
        var urlNivEdu = "@Url.Action("NivelesEducacionales","Lookup")";
        var urlSitLab = "@Url.Action("SituacionesLaborales","Lookup")";
        var urlReg    = "@Url.Action("Regiones","Lookup")";

        var padreNacID  = @Html.Raw(Model.ApoderadoPadre.NacionalidadID.HasValue  ? Model.ApoderadoPadre.NacionalidadID.Value.ToString()  : "null");
        var padreNivID  = @Html.Raw(Model.ApoderadoPadre.NivelEducacionalID.HasValue ? Model.ApoderadoPadre.NivelEducacionalID.Value.ToString() : "null");
        var padreSitID  = @Html.Raw(Model.ApoderadoPadre.SituacionLaboralID.HasValue ? Model.ApoderadoPadre.SituacionLaboralID.Value.ToString() : "null");
        var padreRegID  = @Html.Raw(Model.ApoderadoPadre.RegionID.HasValue  ? Model.ApoderadoPadre.RegionID.Value.ToString()  : "null");
        var padreComID  = @Html.Raw(Model.ApoderadoPadre.ComunaID.HasValue  ? Model.ApoderadoPadre.ComunaID.Value.ToString()  : "null");

        var madreNacID  = @Html.Raw(Model.ApoderadoMadre.NacionalidadID.HasValue  ? Model.ApoderadoMadre.NacionalidadID.Value.ToString()  : "null");
        var madreNivID  = @Html.Raw(Model.ApoderadoMadre.NivelEducacionalID.HasValue ? Model.ApoderadoMadre.NivelEducacionalID.Value.ToString() : "null");
        var madreSitID  = @Html.Raw(Model.ApoderadoMadre.SituacionLaboralID.HasValue ? Model.ApoderadoMadre.SituacionLaboralID.Value.ToString() : "null");
        var madreRegID  = @Html.Raw(Model.ApoderadoMadre.RegionID.HasValue  ? Model.ApoderadoMadre.RegionID.Value.ToString()  : "null");
        var madreComID  = @Html.Raw(Model.ApoderadoMadre.ComunaID.HasValue  ? Model.ApoderadoMadre.ComunaID.Value.ToString()  : "null");

        cargarDdlApo(urlNac,    $('#ddlNacionalidadPadre'), padreNacID);
        cargarDdlApo(urlNivEdu, $('#ddlNivelEducPadre'),    padreNivID);
        cargarDdlApo(urlSitLab, $('#ddlSitLaboralPadre'),   padreSitID);
        cargarDdlApo(urlNac,    $('#ddlNacionalidadMadre'), madreNacID);
        cargarDdlApo(urlNivEdu, $('#ddlNivelEducMadre'),    madreNivID);
        cargarDdlApo(urlSitLab, $('#ddlSitLaboralMadre'),   madreSitID);

        // Regiones Padre
        $.getJSON(urlReg, function (data) {
            $.each(data, function (i, d) {
                $('#ddlRegionPadre, #ddlRegionMadre').append($('<option>').val(d.ID).text(d.Texto));
            });
            if (padreRegID) { $('#ddlRegionPadre').val(padreRegID); cargarComunasApo(padreRegID, padreComID, $('#ddlComunaPadre')); }
            if (madreRegID) { $('#ddlRegionMadre').val(madreRegID); cargarComunasApo(madreRegID, madreComID, $('#ddlComunaMadre')); }
        });

        $('#ddlRegionPadre').change(function () { cargarComunasApo($(this).val(), null, $('#ddlComunaPadre')); });
        $('#ddlRegionMadre').change(function () { cargarComunasApo($(this).val(), null, $('#ddlComunaMadre')); });

        // Formato RUT en tiempo real para apoderados
        aplicarFormatoRut($('#txtRutPadre'));
        aplicarFormatoRut($('#txtRutMadre'));

        // Búsqueda de apoderado existente por RUT
        function buscarApoderadoPorRut(rutInput, feedbackId, prefijo, ddlNac, ddlNiv, ddlSit, ddlReg, ddlCom) {
            var rut = $(rutInput).val().trim();
            if (!rut) return;
            $('#' + feedbackId).text('Buscando...').css('color', 'gray');
            $.getJSON("@Url.Action("BuscarPorRut","Apoderado")", { rut: rut }, function (apo) {
                if (!apo || !apo.ID) {
                    $('#' + feedbackId).text('No encontrado. Complete los datos manualmente.').css('color', 'orange');
                } else {
                    $('#' + prefijo + '_ApoderadoID').val(apo.ID);
                    $('#' + prefijo + '_ApellidoPaterno').val(apo.ApellidoPaterno || '');
                    $('#' + prefijo + '_ApellidoMaterno').val(apo.ApellidoMaterno || '');
                    $('#' + prefijo + '_Nombres').val(apo.Nombres || '');
                    $('#' + prefijo + '_Telefono').val(apo.Telefono || '');
                    $('#' + prefijo + '_TelefonoCelular').val(apo.TelefonoCelular || '');
                    $('#' + prefijo + '_Email').val(apo.Email || '');
                    $('#' + prefijo + '_Direccion').val(apo.Direccion || '');
                    $('#' + prefijo + '_LugarTrabajo').val(apo.LugarTrabajo || '');
                    if (apo.NacionalidadID)    ddlNac.val(apo.NacionalidadID);
                    if (apo.NivelEducacionalID) ddlNiv.val(apo.NivelEducacionalID);
                    if (apo.SituacionLaboralID) ddlSit.val(apo.SituacionLaboralID);
                    if (apo.RegionID) {
                        ddlReg.val(apo.RegionID);
                        cargarComunasApo(apo.RegionID, apo.ComunaID, ddlCom);
                    }
                    $('#' + feedbackId).text('✔ Datos cargados correctamente.').css('color', 'green');
                }
            }).fail(function () {
                $('#' + feedbackId).text('Error al buscar. Intente nuevamente.').css('color', 'red');
            });
        }

        $('#txtRutPadre').on('blur', function () {
            buscarApoderadoPorRut(this, 'feedbackRutPadre', 'ApoderadoPadre',
                $('#ddlNacionalidadPadre'), $('#ddlNivelEducPadre'), $('#ddlSitLaboralPadre'),
                $('#ddlRegionPadre'), $('#ddlComunaPadre'));
        });
        $('#txtRutMadre').on('blur', function () {
            buscarApoderadoPorRut(this, 'feedbackRutMadre', 'ApoderadoMadre',
                $('#ddlNacionalidadMadre'), $('#ddlNivelEducMadre'), $('#ddlSitLaboralMadre'),
                $('#ddlRegionMadre'), $('#ddlComunaMadre'));
        });

    });
</script>
