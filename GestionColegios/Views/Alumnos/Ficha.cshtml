// Eliminar documento (matrícula o anexo)
$(document).on('click', '.btn-eliminar-doc', function() {
    var docId = $(this).data('id');
    showConfirm({
        tipo: 'danger',
        titulo: 'Eliminar documento',
        mensaje: '¿Confirma que desea eliminar este documento? Esta acción no se puede deshacer.',
        onOk: function() {
            $.post(urlEliminarDoc, { documentoId: docId }).done(function(r) {
                if (r.success) {
                    showToast('success', 'Documento eliminado.');
                    cargarDocsMatricula(anioDocSeleccionado);
                    cargarDocsAnexos();
                } else {
                    showToast('error', 'No se pudo eliminar el documento.');
                }
            });
        }
    });
});

function formatearFechaJson(val) {
    if (!val) return '—';
    var ts = parseInt(val.replace('/Date(', '').replace(')/', ''));
    var d  = new Date(ts);
    return ('0' + d.getDate()).slice(-2) + '/' +
           ('0' + (d.getMonth() + 1)).slice(-2) + '/' +
           d.getFullYear();
}

