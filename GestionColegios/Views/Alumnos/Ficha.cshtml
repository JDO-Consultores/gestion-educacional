function badgeMat(e) {
    var m = {
        "Vigente":    "bg-success",
        "Anulada":    "bg-danger",
        "Trasladada": "bg-warning text-dark",
        "Pendiente":  "bg-info"
    };
    return '<span class="badge ' + (m[e] || "bg-secondary") + '">' + (e || "") + '</span>';
}

function cargarHistorial() {
    $('#tablaHistorial').html(
        '<p class="text-muted text-center py-4">' +
        '<i class="bi bi-hourglass-split me-1"></i>Cargando...</p>');

    $.getJSON('@Url.Action("GetHistorial","Alumnos")', { alumnoId: alumnoId }, function (data) {
        var cfg = {
            'Alumno':    { cls: 'bg-primary',           icon: 'bi-person-fill',       lbl: 'Alumno'    },
            'Matrícula': { cls: 'bg-success',           icon: 'bi-journal-check',     lbl: 'Matrícula' },
            'Alergia':   { cls: 'bg-warning text-dark', icon: 'bi-bandaid-fill',      lbl: 'Alergia'   },
            'Apoderado': { cls: 'bg-info text-dark',    icon: 'bi-people-fill',       lbl: 'Apoderado' },
            'Documento': { cls: 'bg-secondary',         icon: 'bi-file-earmark-text', lbl: 'Documento' }
        };

        var html = '<div class="table-responsive">' +
            '<table class="table table-sm table-hover align-middle">' +
            '<thead class="table-light"><tr>' +
            '<th style="width:110px">Fecha / Hora</th>' +
            '<th style="width:105px">Categoría</th>' +
            '<th style="width:190px">Usuario</th>' +
            '<th>Acción</th>' +
            '<th>Detalle</th>' +
            '</tr></thead><tbody>';

        if (!data || !data.length) {
            html += '<tr><td colspan="5" class="text-center text-muted py-4">' +
                    'Sin registros de actividad.</td></tr>';
        } else {
            $.each(data, function (i, item) {
                var ts = item.FechaAccion
                    ? parseInt(item.FechaAccion.replace('/Date(', '').replace(')/', ''))
                    : null;
                var fd = ts ? new Date(ts) : null;
                var fStr = fd
                    ? ('0' + fd.getDate()).slice(-2) + '/' +
                      ('0' + (fd.getMonth() + 1)).slice(-2) + '/' +
                      fd.getFullYear() +
                      '<br><small class="text-muted">' +
                      ('0' + fd.getHours()).slice(-2) + ':' +
                      ('0' + fd.getMinutes()).slice(-2) + ':' +
                      ('0' + fd.getSeconds()).slice(-2) + '</small>'
                    : '—';
                var ent = item.Entidad || 'Alumno';
                var c   = cfg[ent] || { cls: 'bg-secondary', icon: 'bi-circle', lbl: ent };
                var bdg = '<span class="badge ' + c.cls + '">' +
                          '<i class="bi ' + c.icon + ' me-1"></i>' + c.lbl + '</span>';

                html += '<tr>' +
                    '<td class="text-nowrap small">' + fStr + '</td>' +
                    '<td>' + bdg + '</td>' +
                    '<td class="small">' + (item.Usuario || '—') + '</td>' +
                    '<td class="fw-semibold small">' + (item.Accion || '') + '</td>' +
                    '<td class="small text-muted">' + (item.Detalle || '—') + '</td>' +
                    '</tr>';
            });
        }
        html += '</tbody></table></div>';
        $('#tablaHistorial').html(html);
    }).fail(function () {
        $('#tablaHistorial').html(
            '<p class="text-danger text-center">' +
            '<i class="bi bi-exclamation-triangle me-1"></i>' +
            'Error al cargar el historial.</p>');
    });
}

