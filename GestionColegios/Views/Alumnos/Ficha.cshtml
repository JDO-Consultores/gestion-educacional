var urlGetEstadoMatricula   = "@Url.Action("GetEstadoMatricula","Documento")";
var urlGetAnexos            = "@Url.Action("GetAnexos","Documento")";
var urlGetTiposAnexo        = "@Url.Action("GetTiposAnexo","Documento")";
var urlVerificarObligatorios = "@Url.Action("VerificarObligatorios","Documento")";
var urlSubirMatricula       = "@Url.Action("SubirMatricula","Documento")";
var urlSubirAnexo           = "@Url.Action("SubirAnexo","Documento")";
var urlEliminarDoc          = "@Url.Action("Eliminar","Documento")";
var urlDescargarDoc         = "@Url.Action("Descargar","Documento")";

var anioDocSeleccionado = 0;

// Cargar años escolares en el selector
$.getJSON('@Url.Action("GetAniosEscolares","Lookup")', function(data) {
    var ddl = $('#ddlAnioDocumentos');
    $.each(data, function(i, d) {
        ddl.append($('<option>').val(d.ID).text(d.Texto));
    });
    // Seleccionar primer año automáticamente
    if (data && data.length > 0) {
        ddl.val(data[0].ID);
        anioDocSeleccionado = data[0].ID;
        cargarDocsMatricula(data[0].ID);
    }
});

$('#ddlAnioDocumentos, #btnCargarDocsMatricula').on('change click', function() {
    var anioId = parseInt($('#ddlAnioDocumentos').val());
    if (!anioId) return;
    anioDocSeleccionado = anioId;
    cargarDocsMatricula(anioId);
});

function cargarDocsMatricula(anioId) {
    $('#tablaDocsMatricula').html(
        '<p class="text-muted small text-center py-3">' +
        '<i class="bi bi-hourglass-split me-1"></i>Cargando...</p>');

    $.getJSON(urlGetEstadoMatricula, { alumnoId: alumnoId, anioEscolarId: anioId }, function(data) {
        // Verificar obligatorios para alertas
        $.getJSON(urlVerificarObligatorios, { alumnoId: alumnoId, anioEscolarId: anioId }, function(ver) {
            if (ver.TodosObligatoriosCargados) {
                $('#alertaDocsPendientes').addClass('d-none');
                $('#alertaDocsCompletos').removeClass('d-none');
            } else {
                $('#alertaDocsCompletos').addClass('d-none');
                $('#alertaDocsPendientes').removeClass('d-none');
                $('#txtDocsPendientes').text(' ' + ver.FaltanDocumentos.join(', '));
            }
        });

        if (!data || !data.length) {
            $('#tablaDocsMatricula').html(
                '<p class="text-muted small text-center py-3">' +
                'No hay tipos de documento configurados para matrícula.</p>');
            return;
        }

        // El servidor devuelve los datos ya ordenados por OrdenImportancia.
        // Agrupar en 4 bloques de importancia para mostrarlos separados.
        var gruposImp = {
            1: { titulo: 'Obligatorios pendientes',  icon: 'bi-exclamation-circle-fill', cls: 'text-danger',         filaClass: 'table-danger'  },
            2: { titulo: 'Obligatorios cargados',    icon: 'bi-check-circle-fill',        cls: 'text-success',        filaClass: ''              },
            3: { titulo: 'Opcionales pendientes',    icon: 'bi-dash-circle',              cls: 'text-warning',        filaClass: 'table-warning' },
            4: { titulo: 'Opcionales cargados',      icon: 'bi-check-circle',             cls: 'text-secondary',      filaClass: ''              }
        };

        var grupos = { 1: [], 2: [], 3: [], 4: [] };
        $.each(data, function(i, d) {
            var k = d.OrdenImportancia || 4;
            if (!grupos[k]) grupos[k] = [];
            grupos[k].push(d);
        });

        // Config visual por categoría (para el sub-separador dentro de cada bloque)
        var catLabels = {
            'Reglamentario': 'Reglamentario',
            'Autorizacion':  'Autorización',
            'Interno':       'Interno'
        };

        var html = '';
        $.each([1, 2, 3, 4], function(_, imp) {
            var docs = grupos[imp];
            if (!docs || !docs.length) return;

            var g = gruposImp[imp];
            html += '<div class="mb-3">';
            // Encabezado del grupo de importancia
            html += '<p class="fw-bold small mb-2 d-flex align-items-center gap-1 ' + g.cls + '">' +
                    '<i class="bi ' + g.icon + '"></i>' + g.titulo +
                    ' <span class="badge rounded-pill bg-light border text-dark fw-normal ms-1">' + docs.length + '</span>' +
                    '</p>';
            html += '<div class="table-responsive">';
            html += '<table class="table table-sm table-hover align-middle mb-0">';
            html += '<thead class="table-light"><tr>' +
                    '<th>Documento</th>' +
                    '<th style="width:100px" class="text-center">Categoría</th>' +
                    '<th style="width:120px">Archivo</th>' +
                    '<th style="width:100px">Fecha carga</th>' +
                    '<th style="width:110px" class="text-center">Acciones</th>' +
                    '</tr></thead><tbody>';

            $.each(docs, function(j, doc) {
                var catLabel = catLabels[doc.Categoria] || (doc.Categoria || '—');
                var badgeCat = doc.Obligatorio
                    ? '<span class="badge bg-danger bg-opacity-10 text-danger border border-danger-subtle small">' + catLabel + '</span>'
                    : '<span class="badge bg-secondary bg-opacity-10 text-secondary border border-secondary-subtle small">' + catLabel + '</span>';

                var badgeEst = doc.Cargado
                    ? '<i class="bi bi-check-circle-fill text-success" title="Cargado"></i>'
                    : '<i class="bi bi-clock-fill text-warning" title="Pendiente"></i>';

                var nombreArch = doc.NombreArchivo
                    ? '<span class="text-truncate d-inline-block" style="max-width:110px" title="' + doc.NombreArchivo + '">' +
                      '<i class="bi bi-file-earmark me-1 text-muted"></i>' + doc.NombreArchivo + '</span>'
                    : '<span class="text-muted small">—</span>';

                var fechaCarga = doc.FechaCarga ? formatearFechaJson(doc.FechaCarga) : '—';

                var acciones = '';
                if (doc.Cargado) {
                    acciones += '<a href="' + urlDescargarDoc + '/' + doc.DocumentoAlumnoID + '" ' +
                                'target="_blank" class="btn btn-outline-secondary btn-sm me-1" ' +
                                'title="Descargar"><i class="bi bi-download"></i></a>';
                    if (isAdmin && !fueTraspasado) {
                        acciones += '<button class="btn btn-outline-danger btn-sm btn-eliminar-doc" ' +
                                    'data-id="' + doc.DocumentoAlumnoID + '" title="Eliminar">' +
                                    '<i class="bi bi-trash"></i></button>';
                    }
                }
                if (isAdmin && !fueTraspasado) {
                    acciones += '<button class="btn btn-sm ms-1 ' +
                                (!doc.Cargado ? 'btn-primary' : 'btn-outline-primary') +
                                ' btn-subir-doc-mat" ' +
                                'data-tipoid="' + doc.TipoDocumentoID + '" ' +
                                'data-nombre="' + doc.Nombre + '" ' +
                                'title="' + (doc.Cargado ? 'Reemplazar' : 'Subir documento') + '">' +
                                '<i class="bi bi-upload"></i>' +
                                (!doc.Cargado ? ' <span class="small">Subir</span>' : '') +
                                '</button>';
                }

                html += '<tr class="' + g.filaClass + '">' +
                        '<td class="fw-semibold small">' + badgeEst + ' ' + doc.Nombre + '</td>' +
                        '<td class="text-center">' + badgeCat + '</td>' +
                        '<td>' + nombreArch + '</td>' +
                        '<td class="small">' + fechaCarga + '</td>' +
                        '<td class="text-center">' + acciones + '</td>' +
                        '</tr>';
            });

            html += '</tbody></table></div></div>';
        });

        $('#tablaDocsMatricula').html(html);
    }).fail(function() {
        $('#tablaDocsMatricula').html(
            '<p class="text-danger small text-center py-3">' +
            '<i class="bi bi-exclamation-triangle me-1"></i>Error al cargar documentos.</p>');
    });
}

function cargarDocsAnexos() {
    $.getJSON(urlGetAnexos, { alumnoId: alumnoId }, function(data) {
        if (!data || !data.length) {
            $('#tablaDocsAnexos').html(
                '<p class="text-muted small text-center py-3">' +
                'No hay documentos anexos cargados para este alumno.</p>');
            return;
        }
        var html = '<div class="table-responsive">' +
                   '<table class="table table-sm table-hover align-middle">' +
                   '<thead class="table-light"><tr>' +
                   '<th>Tipo</th><th>Archivo</th>' +
                   '<th style="width:115px">Fecha carga</th>' +
                   '<th>Observación</th>' +
                   '<th style="width:100px" class="text-center">Acciones</th>' +
                   '</tr></thead><tbody>';
        $.each(data, function(i, doc) {
            var fechaCarga = doc.FechaCarga ? formatearFechaJson(doc.FechaCarga) : '—';
            var acciones = '<a href="' + urlDescargarDoc + '/' + doc.ID + '" target="_blank" ' +
                           'class="btn btn-outline-secondary btn-sm me-1" title="Descargar">' +
                           '<i class="bi bi-download"></i></a>';
            if (isAdmin && !fueTraspasado) {
                acciones += '<button class="btn btn-outline-danger btn-sm btn-eliminar-doc" ' +
                            'data-id="' + doc.ID + '" title="Eliminar">' +
                            '<i class="bi bi-trash"></i></button>';
            }
            html += '<tr>' +
                    '<td class="fw-semibold small"><i class="bi bi-paperclip text-secondary me-1"></i>' + doc.TipoDocumento + '</td>' +
                    '<td class="small">' + (doc.NombreArchivo || '—') + '</td>' +
                    '<td class="small">' + fechaCarga + '</td>' +
                    '<td class="small text-muted">' + (doc.Observacion || '—') + '</td>' +
                    '<td class="text-center">' + acciones + '</td>' +
                    '</tr>';
        });
        html += '</tbody></table></div>';
        $('#tablaDocsAnexos').html(html);
    });
}

cargarDocsAnexos();

// Ventana subir documento de matrícula
var winSubirDocMat = $('#windowSubirDocMatricula').kendoWindow({
    title: 'Subir Documento de Matrícula', width: '480px',
    modal: true, visible: false, actions: ['Close']
}).data('kendoWindow');

$(document).on('click', '.btn-subir-doc-mat', function() {
    var tipoId   = $(this).data('tipoid');
    var nombre   = $(this).data('nombre');
    $('#hdnTipoDocMatriculaID').val(tipoId);
    $('#hdnTipoDocMatriculaNombre').val(nombre);
    $('#lblTipoDocMatricula').text(nombre);
    $('#fileDocMatricula').val('');
    $('#txtObsDocMatricula').val('');
    winSubirDocMat.center().open();
});

$('#btnConfirmarSubirDocMatricula').click(function() {
    var anioId = parseInt($('#ddlAnioDocumentos').val());
    if (!anioId) { showToast('info', 'Seleccione un año escolar.'); return; }
    var file = $('#fileDocMatricula')[0].files[0];
    if (!file) { showToast('info', 'Debe seleccionar un archivo.'); return; }

    var fd = new FormData();
    fd.append('AlumnoID',        alumnoId);
    fd.append('TipoDocumentoID', $('#hdnTipoDocMatriculaID').val());
    fd.append('AnioEscolarID',   anioId);
    fd.append('Observacion',     $('#txtObsDocMatricula').val());
    fd.append('Archivo',         file);

    showLoading(true);
    $.ajax({
        url: urlSubirMatricula, type: 'POST', data: fd,
        processData: false, contentType: false,
        success: function(r) {
            showLoading(false);
            if (r.success) {
                winSubirDocMat.close();
                showToast('success', r.message);
                cargarDocsMatricula(anioDocSeleccionado);
            } else {
                showToast('error', r.message);
            }
        },
        error: function() {
            showLoading(false);
            showToast('error', 'Error al subir el documento.');
        }
    });
});

