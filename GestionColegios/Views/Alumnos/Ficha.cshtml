var urlGetPlantillasCert = '@Url.Action("GetPlantillas","Certificado")';
var urlGetFirmantesCert  = '@Url.Action("GetFirmantes","Certificado")';
var urlGenerarCert       = '@Url.Action("Generar","Certificado")';

var plantillasCertCache = [];

var winGenerarCert = $('#windowGenerarCertificado').kendoWindow({
    title: 'Generar Certificado', width: '460px',
    modal: true, visible: false, actions: ['Close']
}).data('kendoWindow');

function cargarSelectsCertificado() {
    $.getJSON(urlGetPlantillasCert, function (data) {
        plantillasCertCache = data || [];
        var ddl = $('#ddlPlantillaCert');
        ddl.find('option:gt(0)').remove();
        $.each(plantillasCertCache, function (i, p) {
            ddl.append($('<option>').val(p.ID).text(p.Nombre).attr('data-firmante', p.FirmanteDefectoID || ''));
        });
    });
    $.getJSON(urlGetFirmantesCert, function (data) {
        var ddl = $('#ddlFirmanteCert');
        ddl.find('option:gt(0)').remove();
        $.each(data || [], function (i, f) {
            ddl.append($('<option>').val(f.ID).text(f.Nombre + ' — ' + f.Cargo));
        });
    });
}
cargarSelectsCertificado();

$('#ddlPlantillaCert').on('change', function () {
    var id = parseInt($(this).val());
    var p = plantillasCertCache.filter(function (x) { return x.ID === id; })[0];
    $('#descPlantillaCert').text(p ? (p.Descripcion || '') : '');
    // Preseleccionar el firmante por defecto de la plantilla
    if (p && p.FirmanteDefectoID) {
        $('#ddlFirmanteCert').val(p.FirmanteDefectoID);
    } else {
        $('#ddlFirmanteCert').val('');
    }
});

$('#btnGenerarCertificado').click(function () {
    $('#ddlPlantillaCert').val('');
    $('#ddlFirmanteCert').val('');
    $('#descPlantillaCert').text('');
    winGenerarCert.center().open();
});

$('#btnConfirmarGenerarCert').click(function () {
    var plantillaId = parseInt($('#ddlPlantillaCert').val());
    if (!plantillaId) { showToast('info', 'Seleccione un tipo de certificado.'); return; }
    var firmanteId = $('#ddlFirmanteCert').val();

    var url = urlGenerarCert + '?plantillaId=' + plantillaId + '&alumnoId=' + alumnoId;
    if (firmanteId) url += '&firmanteId=' + firmanteId;

    // Descarga directa del .docx
    window.location.href = url;
    winGenerarCert.close();
    showToast('success', 'Generando certificado...');
});
